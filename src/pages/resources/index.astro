---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Accordion from 'src/components/Accordion.astro';
import AccordionGroup from 'src/components/AccordionGroup.astro';
import MediaDialog from 'src/components/dialogs/MediaDialog.astro';
import LinksListItem from 'src/components/LinksListItem.astro';

import IconCheckmark from '../../components/icons/IconCheckmark_8.astro';
import IconFilter from 'src/components/icons/IconFilter_20.astro';
import IconFilterClear from 'src/components/icons/IconFilterClear_20.astro';
import IconWarning from 'src/components/icons/IconWarning_16.astro';
import IconSearch from 'src/components/icons/IconSearch_20.astro';
import IconSortAlpha from 'src/components/icons/IconAlpha_20.astro';
import IconSortTime from 'src/components/icons/IconTime_20.astro';
import IconCompact from 'src/components/icons/IconCompact_20.astro';
import IconDetailed from 'src/components/icons/IconDetailed_20.astro';
import IconXmarkSmall from 'src/components/icons/IconXmark_12.astro';
import IconXmarkBig from 'src/components/icons/IconXmark_20.astro';
import { findObjectByKey } from 'src/utilities/helpers';

let searchList = [];
let itemIndex = 1;

let allResources = await getCollection('resources', ({ data }) => {
	return data.published === true;
});

for (let resource of allResources) {
	let data = JSON.parse(JSON.stringify(resource.data));
	data.itemId = `res-${itemIndex}`;
	data.category = 'resource';
	data.slug = resource.id;
	searchList.push(data);
	itemIndex += 1;
}

searchList.sort((a, b) => {
	let toDate = (value?: Date) => (value ? new Date(value) : new Date(0));
	return toDate(b.dateAdded).getTime() - toDate(a.dateAdded).getTime();
});

let allIndicators = await getCollection('indicators');

allIndicators.sort((a, b) => {
	return (a.data.tag || '').localeCompare(b.data.tag || '');
});

let allComponents = await getCollection('components');

allComponents.map((component) => {
	let indicator = findObjectByKey(allIndicators, 'id', component.data.indicator);
	component.data['colour'] = indicator.data.colour;
});

allComponents.sort((a, b) => {
	return (a.data.tag || '').localeCompare(b.data.tag || '');
});

let allTypes = new Set();
allResources.map((resource) => {
	allTypes.add(resource.data.type.charAt(0).toUpperCase() + resource.data.type.slice(1));
});

let types = [...allTypes].sort((a: string, b: string) => {
	return a.localeCompare(b);
}) as Array<string>;
---

<BaseLayout
	pageTitle={'Resources'}
	pageType={'resources'}
>
	<aside
		id="filters-aside"
		class="left-aside"
	>
		<div class="wrapper">
			<form
				id="resources-list-secondary-controls"
				class="list-secondary-controls"
				data-list="resources-list"
			>
				<div class="heading-group">
					<h2
						id="resources-list-secondary-controls_heading"
						class="heading"
					>
						<!-- <IconFilter /> -->
						<span>Filters</span>
					</h2>
					<label
						class="reset-input-container filters-reset"
						data-style-as="button"
					>
						<span class="icon-and-label-container">
							<IconFilterClear />
							<!-- <span class="label-container">
								<span class="label">Clear Filters</span>
								</span> -->
						</span>
						<input
							type="reset"
							value=""
							disabled
						/>
					</label>
					<div
						class="separator"
						data-orientation="vertical"
						aria-hidden="true"
						data-restrict-device-max="medium"
					>
					</div>
					<button
						class="close"
						type="button"
						aria-label="Close Filters"
						data-restrict-device-max="medium"
					>
						<IconXmarkBig />
					</button>
				</div>
				<div
					class="separator group"
					aria-hidden="true"
				>
				</div>
				<AccordionGroup
					includeControls={false}
					dataset=""
				>
					<Accordion
						title={'Type'}
						id={'filters_type'}
						headingLevel="3"
						caretIconSize={'small'}
						wrapper={false}
						dataset={[
							{ key: 'style', value: 'flat' },
							{ key: 'size', value: 'small' },
						]}
					>
						<span
							class="filter-group-status label-container field-container"
							slot="button-meta"
							hidden
						>
							<span data-field="filtersTypesStatus">0</span>&nbsp;Selected</span
						>
						<div
							class="separator item"
							aria-hidden="true"
						>
						</div>
						<fieldset
							class="filters"
							aria-labelledby="filters_type"
						>
							{
								types.map((type) => (
									<label>
										<input
											type="checkbox"
											name="types"
											value={type.toLowerCase()}
											data-title={type}
											data-status-field="filtersTypesStatus"
										/>
										<IconCheckmark />
										<span class="text-container">{type}</span>
									</label>
								))
							}
						</fieldset>
					</Accordion>
					<div
						class="separator group"
						aria-hidden="true"
					>
					</div>
					<Accordion
						title={'Indicator'}
						id={'filters_indicator'}
						headingLevel="3"
						caretIconSize={'small'}
						wrapper={false}
						dataset={[
							{ key: 'style', value: 'flat' },
							{ key: 'size', value: 'small' },
						]}
					>
						<span
							class="filter-group-status label-container field-container"
							slot="button-meta"
							hidden
						>
							<span data-field="filtersIndicatorsStatus">0</span>&nbsp;Selected</span
						>
						<div
							class="separator item"
							aria-hidden="true"
						>
						</div>
						<fieldset
							class="filters"
							aria-labelledby="filters_indicator"
						>
							{
								allIndicators.map((indicator) => (
									<label>
										<input
											type="checkbox"
											name="indicators"
											value={indicator.data.tag}
											data-title={indicator.data.title}
											data-status-field="filtersIndicatorsStatus"
										/>
										<IconCheckmark />
										<span class="text-container">
											<span
												class="tag"
												data-theme={indicator.data['colour']}
												data-vibrancy="vivid"
											>
												{indicator.data.tag}
											</span>
											<span class="text">{indicator.data.title}</span>
										</span>
									</label>
								))
							}
						</fieldset>
					</Accordion>
					<div
						class="separator group"
						aria-hidden="true"
					>
					</div>
					<Accordion
						title={'Component'}
						id={'filters_components'}
						headingLevel="3"
						caretIconSize={'small'}
						wrapper={false}
						dataset={[
							{ key: 'style', value: 'flat' },
							{ key: 'size', value: 'small' },
						]}
					>
						<span
							class="filter-group-status label-container field-container"
							slot="button-meta"
							hidden
						>
							<span data-field="filtersComponentsStatus">0</span>&nbsp;Selected</span
						>
						<div
							class="separator item"
							aria-hidden="true"
						>
						</div>
						<fieldset
							class="filters"
							aria-labelledby="filters_component"
						>
							{
								allComponents.map((component) => (
									<label>
										<input
											type="checkbox"
											name="components"
											value={component.data.tag}
											data-title={component.data.title}
											data-status-field="filtersComponentsStatus"
										/>
										<IconCheckmark />
										<span class="text-container">
											<span
												class="tag"
												data-theme={component.data['colour']}
												data-vibrancy="vivid"
											>
												{component.data.tag}
											</span>
											<span class="text">{component.data.title}</span>
										</span>
									</label>
								))
							}
						</fieldset>
					</Accordion>
				</AccordionGroup>
			</form>
		</div>
	</aside>
	<dialog
		id="resources-filters-dialog"
		aria-labelledby="resources-list-secondary-controls_heading"
	>
	</dialog>

	<div class="content">
		<h1
			id="main-heading"
			tabindex="-1"
		>
			Resources
		</h1>

		<ul
			id="active-filters-list"
			class="field-values-list"
		>
			<template>
				<li
					class="filter-tag"
					data-group=""
					data-value=""
					data-status-field=""
				>
					<span class="group"></span>
					<span
						class="title"
						title=""
					></span>
					<button
						class="clear"
						type="button"
						aria-label=""
					>
						<IconXmarkSmall />
					</button>
				</li>
			</template>
		</ul>

		<form
			id="resources-list-primary-controls"
			class="list-primary-controls"
			data-list="resources-list"
		>
			<fieldset class="search">
				<div class="input-container">
					<input
						name="search"
						type="text"
						role="combobox"
						autocomplete="off"
						aria-autocomplete="list"
						aria-expanded="true"
						aria-controls="resources-list"
						aria-activedescendant=""
						placeholder="Search these resources..."
						aria-label="Search and filter resources"
						aria-describedby="resources-list_error-status, resources-list_filter-status"
					/>
					<IconSearch />
				</div>
			</fieldset>
			<div class="fieldset-group">
				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
					data-restrict-device-max="medium"
				>
				</div>
				<fieldset
					class="filter"
					data-restrict-device-max="medium"
				>
					<legend aria-label="List Filter Options">Filter</legend>
					<div class="button-group">
						<button
							class="filters-toggle"
							type="button"
							aria-label="Open filter options"
							aria-expanded="false"
						>
							<span class="icon-and-label-container">
								<IconFilter />
								<span class="label-container">
									<span class="label">Open</span>
								</span>
							</span>
						</button>
						<button
							class="filters-reset"
							type="button"
							aria-label="Clear all filters"
							disabled
						>
							<span class="icon-and-label-container">
								<IconFilterClear />
								<span class="label-container">
									<span class="label">Clear</span>
								</span>
							</span>
						</button>
					</div>
				</fieldset>
				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
				>
				</div>
				<fieldset
					class="sort"
					data-value="date"
				>
					<legend aria-label="List Sort Options">Sort</legend>
					<div class="button-group">
						<button
							type="button"
							value="date"
							aria-label="Sort list by date added"
							aria-pressed="true"
						>
							<span class="icon-and-label-container">
								<IconSortTime />
								<span class="label-container">
									<span class="label">Date</span>
								</span>
							</span>
						</button>
						<button
							type="button"
							value="title"
							aria-label="Sort list by title"
							aria-pressed="false"
						>
							<span class="icon-and-label-container">
								<IconSortAlpha />
								<span class="label-container">
									<span class="label">Title</span>
								</span>
							</span>
						</button>
					</div>
				</fieldset>
				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
				>
				</div>
				<fieldset
					class="layout"
					data-value="compact"
				>
					<legend aria-label="List Layout Options">Layout</legend>
					<div class="button-group">
						<button
							type="button"
							value="list-compact"
							aria-label="Switch to compact list layout"
							aria-pressed="true"
						>
							<span class="icon-and-label-container">
								<IconCompact />
								<span class="label-container">
									<span class="label">Compact</span>
									<span
										data-screen-reader
										hidden
										>Compact view unavailable for this filter</span
									>
								</span>
							</span>
						</button>
						<button
							type="button"
							value="list-detailed"
							aria-label="Switch to compact list layout"
							aria-pressed="false"
						>
							<span class="icon-and-label-container">
								<IconDetailed />
								<span class="label-container">
									<span class="label">Detailed</span>
								</span>
							</span>
						</button>
					</div>
				</fieldset>
			</div>
		</form>

		<div class="list-container">
			<p
				id="resources-list_error-status"
				class="error-status"
				role="status"
				hidden
			>
				<IconWarning aria-hidden="true" />
				<span>There are no results that match the search term.</span>
			</p>
			<p
				id="resources-list_filter-status"
				class="filter-status"
				role="status"
				aria-live="polite"
				hidden
			>
			</p>

			<ul
				id="resources-list"
				class="links-list"
				role="listbox"
				data-style="divided"
				data-layout="list-compact"
				data-content="asset"
				data-sort-control="resources-list-primary-controls"
				data-filter-control="resources-list-secondary-controls"
				data-search-control="resources-list-primary-controls"
				data-filter-tag-list="active-filters-list"
				data-default-item-visibility="shown"
				data-list-item-categories='["resource"]'
			>
				{
					searchList.map((item, index) => (
						<LinksListItem
							itemData={item}
							index={index}
							listName={'resources-list'}
							listGroupSize={10}
						/>
					))
				}
			</ul>

			<button
				class="show-more"
				type="button"
				data-list="resources-list"
				data-style="solid"
				data-size="large"
			>
				Show More Results
			</button>
		</div>
	</div>
</BaseLayout>

<style is:global>
	/* 
	// Device Restrictions
	*/

	@container main (width < 744px) {
		:is(#filters-aside, main.resources .content) [data-restrict-device-min='medium'] {
			display: none !important;
		}
	}

	@container main (744px <= width < 1016px) {
		:is(#filters-aside, main.resources .content) [data-restrict-device-max='small'] {
			display: none !important;
		}
	}

	@container main (width >= 1016px) {
		:is(#filters-aside, main.resources .content) [data-restrict-device-max='small'],
		:is(#filters-aside, main.resources .content) [data-restrict-device-max='medium'] {
			display: none !important;
		}
	}

	/* 
	// Filters Aside
	*/

	#filters-aside {
		margin: 0;
		height: 100vh;
		position: sticky;
		top: 0;
		z-index: 10;

		@container main (width < 1016px) {
			display: initial;
			margin: 0;
			min-width: auto;
			width: 0;
		}

		& > .wrapper {
			padding: var(--space-xl) 0;
			min-width: 300px;
			height: 100%;
			border-right: 1px solid var(--colour-brd-subtle);
			background-color: var(--colour-bkg-canvas-subtle-1);

			@container main (width < 1016px) {
				width: 300px;
				box-shadow: var(--box-shadow);
				translate: -300px;
				transition: translate var(--transition-ease-medium);
			}

			main:has(button.filters-toggle[aria-expanded='true']) & {
				@container main (width < 1016px) {
					translate: 0;
				}
			}
		}
	}

	/* 
	// Secondary List Controls
	*/

	#resources-list-secondary-controls {
		gap: var(--space-2xs);

		& .heading-group {
			display: flex;
			flex-flow: row nowrap;
			align-items: center;
			gap: var(--space-2xs);
			margin: 0 var(--space-2xs);

			& .heading {
				font-size: var(--font-size-lg);
				margin: 0 0 0 var(--space-xs);
				flex-grow: 1;
			}

			& .separator {
				--separator-long-edge-dimension: 1.75rem;
			}

			/* Reset and Close Buttons */

			& :is(button, [data-style-as='button']) {
				--button-bkg-colour: transparent;
				--icon-size: 1.25rem;
				margin: 0;

				&:is(:hover, :focus-visible),
				&:has(input:focus-visible) {
					--button-bkg-colour: var(--colour-bkg-surface-subtle-1);
				}

				&:has(input[type='reset']:focus-visible) {
					outline: var(--colour-focus-ring) solid 2px;
					outline-offset: 3px;
				}
			}

			/* Dialog Customization */

			dialog & {
				margin: 0 0 var(--space-3xs);

				& .heading {
					font-size: var(--font-size-2xl);
					margin: 0;
				}

				& + .separator.group {
					--separator-short-edge-dimension: 2px;
				}
			}
		}

		/* Accordion Customization */

		& .accordion-group {
			margin: 0;

			& .accordion {
				& > .heading {
					margin: 0 var(--space-2xs);
				}

				& .panel {
					margin: 0 var(--space-2xs);
					padding-top: var(--space-3xs);
				}
			}

			/* Dialog Customization */

			dialog & {
				& .accordion {
					& > .heading {
						margin: 0;
					}
				}
			}
		}

		/* Separators */

		& .separator.item {
			--separator-long-edge-dimension: auto;
			margin: 0 var(--space-xs);

			/* Dialog Customization */

			dialog & {
				margin: 0;
			}
		}

		/* 
		// Fieldsets and Inputs 
		*/

		& fieldset.filters {
			padding: var(--space-xs) 0 var(--space-2xs);
			max-height: min(500px, 50vh);
			overflow: auto;

			/* Dialog Customization */

			dialog & {
				overflow: initial;
				max-height: none;
			}

			& label {
				&:has(input[type='checkbox']) {
					margin: 0 var(--space-xs);
					padding: var(--space-2xs) var(--space-xs);
					border-radius: var(--brd-radius-small);

					& .icon.checkmark {
						top: 0.75rem;
						left: 1rem;
					}

					/* Dialog Customization */

					dialog & {
						margin: 0;
					}
				}

				&:has(input[type='checkbox']:is(:hover, :focus-visible)) {
					background-color: var(--colour-bkg-surface-subtle-1);
				}

				&:has(input[type='checkbox']:focus-visible) {
					outline: var(--colour-focus-ring) solid 2px;
					outline-offset: 3px;
				}
			}
		}
	}

	/* 
	// Primary List Controls
	------------------------*/

	#resources-list-primary-controls {
		&,
		& .fieldset-group {
			display: flex;
			flex-flow: row nowrap;
			align-items: end;
			column-gap: var(--space-sm);
			row-gap: var(--space-base);
			user-select: none;
			-webkit-user-select: none;
		}

		@container main (width < 744px) {
			flex-flow: column;
			align-items: stretch;
		}

		& .fieldset-group {
			@container main (width < 744px) {
				flex-wrap: wrap;
			}

			& .separator {
				--separator-long-edge-dimension: 1.5rem;
				margin-bottom: var(--space-3xs);

				@container main (width < 744px) {
					&:first-of-type {
						display: none;
					}
				}
			}
		}

		& fieldset {
			&.search {
				flex-grow: 1;
			}

			&:is(.filter, .sort, .layout) {
				--group-gap: var(--space-2xs);

				& legend {
					font-size: var(--font-size-3xs);
					color: var(--colour-txt-on-subtle-2);
					margin: 0 0 0.325rem;
				}

				& button {
					--icon-size: 1.25rem;
					font-size: var(--font-size-2xs);
					height: 2rem;

					&:not(:is([aria-pressed='true'], [aria-expanded='true'])):is(
							:hover,
							:focus-visible
						) {
						--button-bkg-colour: transparent;
						--button-boxshadow-colour: var(--colour-brd-subtle);
					}

					&:is([aria-pressed='true'], [aria-expanded='true']) {
						--icon-colour: var(--colour-txt-on-bold-1);
						--label-colour: var(--colour-txt-on-bold-1);
					}

					&[aria-pressed='true'] {
						pointer-events: none;
					}

					& .label-container {
						display: none;
					}
				}
			}

			&:disabled
				button:is([aria-pressed='true'], [aria-expanded='true'], :has(input:checked)) {
				--button-bkg-colour: var(--colour-bkg-surface-subtle-1);
				--button-txt-colour: var(--colour-txt-on-subtle-1);
				--icon-colour: var(--colour-txt-on-subtle-1);
				--label-colour: var(--colour-txt-on-subtle-1);
			}
		}
	}
</style>

<script>
	//
	// Imports
	//

	import { getUserData } from 'src/stores/userDataStore';
	import { dialogControl } from 'src/utilities/dialog';
	import { eventControl } from 'src/utilities/event';
	import { resetForm } from 'src/utilities/form';
	import { filter, search, sort, layout } from 'src/utilities/list';

	//
	// Methods
	//

	let toggleForcedLayout = (forceLayout: Boolean) => {
		let resourcesList = document.querySelector('#resources-list');
		let layoutDetailedBtn = document.querySelector(
			'fieldset.layout button[value="list-detailed"]',
		);
		let layoutCompactBtn = document.querySelector(
			'fieldset.layout button[value="list-compact"]',
		);
		let screenReaderContext = layoutCompactBtn?.querySelector('[data-screen-reader]');

		if (forceLayout) {
			resourcesList.setAttribute('data-layout', 'list-detailed');
			layoutCompactBtn.setAttribute('disabled', '');
			layoutCompactBtn.setAttribute('aria-pressed', 'false');
			screenReaderContext.removeAttribute('hidden');
			layoutDetailedBtn.setAttribute('aria-pressed', 'true');
		} else {
			let userLayoutPreference = getUserData().uiPreferences.resourcePageLayout;

			if (userLayoutPreference === 'list-compact') {
				resourcesList.setAttribute('data-layout', 'list-compact');
				layoutCompactBtn.setAttribute('aria-pressed', 'true');
				layoutDetailedBtn.setAttribute('aria-pressed', 'false');
			} else {
				resourcesList.setAttribute('data-layout', 'list-detailed');
				layoutCompactBtn.setAttribute('aria-pressed', 'false');
				layoutDetailedBtn.setAttribute('aria-pressed', 'true');
			}

			layoutCompactBtn.removeAttribute('disabled');
			screenReaderContext.setAttribute('hidden', '');
		}
	};

	//
	// Inits
	//

	filter.init();
	eventControl.add({
		elem: document,
		eventType: 'astro:after-swap',
		fn: filter.init,
	});

	sort.init();
	eventControl.add({
		elem: document,
		eventType: 'astro:after-swap',
		fn: sort.init,
	});

	layout.init();
	eventControl.add({
		elem: document,
		eventType: 'astro:after-swap',
		fn: layout.init,
	});

	//
	// Event Listeners
	//

	let onSearchMatchFound = (event: CustomEvent) => {
		let { listId, listMatchTypes } = event.detail;
		if (listId !== 'resources-list') return;
		let forceLayout = listMatchTypes.has('description');
		toggleForcedLayout(forceLayout);
	};
	eventControl.add({
		elem: document,
		eventType: 'searchMatchFound',
		fn: onSearchMatchFound,
	});

	let onControlsClick = (event) => {
		let target = event.target as any;

		if (target.matches('button.filters-toggle')) {
			let isExpanded = target.getAttribute('aria-expanded') === 'true';
			let parent = document
				.querySelector('#resources-list-secondary-controls')
				.parentElement.matches('dialog')
				? 'dialog'
				: 'aside';

			// Open the panel
			if (!isExpanded) {
				if (parent === 'dialog') {
					dialogControl.open({
						dialogId: 'resources-filters-dialog',
					});
				}
			}

			target.setAttribute('aria-expanded', String(!isExpanded));
		}

		if (target.matches('button.filters-reset')) {
			let form = document.querySelector(
				'#resources-list-secondary-controls',
			) as HTMLFormElement;
			if (!form) return;
			form.reset();
		}
	};
	eventControl.add({
		selector: '.list-primary-controls',
		eventType: 'click',
		fn: onControlsClick,
	});

	let onAsideClick = (event) => {
		let target = event.target as any;

		if (target.matches('button.close')) {
			let filtersToggle = document.querySelector(
				'#resources-list-primary-controls button.filters-toggle',
			);
			if (!filtersToggle) return;
			filtersToggle.setAttribute('aria-expanded', 'false');
		}
	};
	eventControl.add({
		selector: '#filters-aside',
		eventType: 'click',
		fn: onAsideClick,
	});

	let onDialogClick = (event) => {
		let target = event.target as any;

		if (target.matches('button.close')) {
			dialogControl.close(target);
			let filtersToggle = document.querySelector(
				'#resources-list-primary-controls button.filters-toggle',
			);
			if (!filtersToggle) return;
			filtersToggle.setAttribute('aria-expanded', 'false');
		}
	};
	eventControl.add({
		selector: '#resources-filters-dialog',
		eventType: 'click',
		fn: onDialogClick,
	});

	let onFilterChange = (event: CustomEvent) => {
		let detail = event.detail;

		let resetFiltersBtns = document.querySelectorAll('.filters-reset');
		if (!resetFiltersBtns) return;
		if (Object.keys(detail.activeFilters).length > 0) {
			for (let btn of resetFiltersBtns) {
				let input = btn.querySelector('input');
				if (input) {
					input.removeAttribute('disabled');
				} else {
					btn.removeAttribute('disabled');
				}
			}
		} else {
			for (let btn of resetFiltersBtns) {
				let input = btn.querySelector('input');
				if (input) {
					input.setAttribute('disabled', '');
				} else {
					btn.setAttribute('disabled', '');
				}
			}
		}
	};
	eventControl.add({
		elem: document,
		eventType: 'filterChange',
		fn: onFilterChange,
	});

	let toggleFiltersContainer = (event, init = false) => {
		let primaryControls = document.querySelector('#resources-list-primary-controls');
		if (!primaryControls) return;

		let filtersToggle = primaryControls.querySelector('button.filters-toggle');
		if (!filtersToggle) return;
		let isExpanded = filtersToggle.getAttribute('aria-expanded') === 'true';

		let filtersAside = document.querySelector('#filters-aside>.wrapper');
		let filtersDialog = document.querySelector('#resources-filters-dialog');
		let secondaryControls = document.querySelector('#resources-list-secondary-controls');
		if (!filtersAside || !filtersDialog || !secondaryControls) return;

		// Resizing from larger to smaller (<744px)
		if (event.matches) {
			// Switch drawer to modal
			if (secondaryControls.parentElement === filtersDialog) return;
			filtersDialog.append(secondaryControls);
			filtersAside.parentElement.setAttribute('hidden', '');
			if (isExpanded) {
				dialogControl.open({
					dialogId: 'resources-filters-dialog',
				});
			}
		}
		// Resizing from smaller to larger (>744px)
		else if (!event.matches && !init) {
			// Switch modal to drawer
			if (secondaryControls.parentElement === filtersAside) return;
			filtersAside.append(secondaryControls);
			filtersAside.parentElement.removeAttribute('hidden');
			if (isExpanded) {
				dialogControl.close(filtersDialog);
			}
		}
	};

	let toggleSearchPosition = (event, init = false) => {
		let primaryControls = document.querySelector('#resources-list-primary-controls');
		if (!primaryControls) return;

		let searchFieldset = primaryControls.querySelector('fieldset.search');
		if (!searchFieldset) return;

		// Resizing from larger to smaller (<744px)
		if (event.matches) {
			// Move fieldset below buttons
			primaryControls.append(searchFieldset);
		}
		// Resizing from smaller to larger (>744px)
		else if (!event.matches && !init) {
			// Move fieldset above buttons
			primaryControls.prepend(searchFieldset);
		}
	};

	let onMediaQueryChange = (event) => {
		toggleFiltersContainer(event);
		toggleSearchPosition(event);
	};
	// Special case event listener, cannot be attached to the document and delegated
	let mediaQuery = window.matchMedia('(max-width: 744px)');
	eventControl.add({
		elem: mediaQuery,
		eventType: 'change',
		fn: onMediaQueryChange,
	});

	let onPageLoad = () => {
		let main = document.querySelector('main');
		if (!main.matches('.resources')) return;

		let filtersAside = document.querySelector('#filters-aside>.wrapper');
		let secondaryControls = filtersAside.querySelector('#resources-list-secondary-controls');
		resetForm({ form: secondaryControls, resetType: 'hard' });

		let mediaQuery = window.matchMedia('(max-width: 744px)');
		toggleFiltersContainer(mediaQuery, true);
		toggleSearchPosition(mediaQuery, true);
	};
	eventControl.add({
		elem: document,
		eventType: 'DOMContentLoaded',
		fn: onPageLoad,
	});
</script>
