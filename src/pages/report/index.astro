---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import AssessmentToolbar from '../../components/AssessmentToolbar.astro';
import IconFolder20 from 'src/components/icons/IconFolder_20.astro';
import ProgressChart from 'src/components/charts/ProgressChart.astro';
import MatrixChart from 'src/components/charts/MatrixChart.astro';
import ReportDialogs from 'src/components/dialogs/ReportDialogs.astro';
import IconWarningBig from 'src/components/icons/IconWarning_24.astro';
import { findObjectByKey } from 'src/utilities/helpers';
import PageNav from 'src/components/PageNav.astro';

import gnbLogo from 'src/images/gnb-logo-colour.png';
import AssessmentDialogs from 'src/components/dialogs/AssessmentDialogs.astro';
import AssessmentToasts from 'src/components/AssessmentToasts.astro';
import BarChart from 'src/components/charts/BarChart.astro';

// Get all indicators
let allIndicators = await getCollection('indicators');

let indicators = allIndicators.sort((a, b) => a.data.tag.localeCompare(b.data.tag));

// Get all components
let allComponents = await getCollection('components');

let components = allComponents.sort((a, b) => a.data.tag.localeCompare(b.data.tag));
components = components.map((component) => {
	let colour = findObjectByKey(allIndicators, 'id', component.data.indicator)?.data.colour;
	return {
		...component,
		data: {
			...component.data,
			colour,
		},
	};
});

let path = Astro.url.pathname;

let navSections = [];

let onPageSection = { title: 'In this report', links: [] };
onPageSection.links.push({
	url: `${path}#overview`,
	text: 'Overview',
	dataset: [
		{
			key: 'tag',
			value: '0',
		},
		{
			key: 'icon-on-hover',
			value: '',
		},
	],
});

for (let indicator of indicators) {
	onPageSection.links.push({
		url: `${path}#indicator-${indicator.data.tag}`,
		text: `${indicator.data.tag}&ensp;${indicator.data.title}`,
		dataset: [
			{
				key: 'tag',
				value: indicator.data.tag,
			},
			{
				key: 'icon-on-hover',
				value: '',
			},
		],
	});
}

navSections.push(onPageSection);
---

<BaseLayout
	pageTitle={'Report'}
	pageType={'report'}
>
	<PageNav
		navSections={navSections}
		dataset={[
			{ key: 'restrict-mode', value: 'assessment' },
			{ key: 'restrict-status', value: 'complete' },
		]}
	/>

	<AssessmentToolbar />

	<AssessmentDialogs />

	<AssessmentToasts slot="toast-group" />

	<ReportDialogs />

	<div class="content report">
		<h1
			id="main-heading"
			tabindex="-1"
			aria-live="polite"
		>
			<span class="title">Report</span>
			<span
				class="subtitle"
				data-font-type="sans-serif"
				data-restrict-status="complete"
			>
				<span data-field="reportSchool"></span>&ensp;&ndash;&ensp;
				<span data-field="reportYear"></span>
			</span>
		</h1>

		<div
			class="callout"
			data-style="solid"
			data-fit="compact"
			data-theme="yellow"
			data-vibrancy="vivid"
			data-restrict-device-max="small"
		>
			<div class="wrapper">
				<div class="icon-container">
					<IconWarningBig />
				</div>
				<div class="text-container">
					<p>
						The report feature isn't available on small screens. Please use a tablet or
						desktop device to access it.
					</p>
				</div>
			</div>
		</div>

		<div
			class="welcome-container"
			data-restrict-device-min="medium"
		>
			<div class="wrapper">
				<div data-restrict-mode="reading">
					<p>To view a report, open an assessment.</p>
					<div class="button-group">
						<button
							class="open-dialog"
							data-dialog="manage-assessments-dialog"
							aria-label="Open or Import Assessment"
							type="button"
							data-style="solid"
							data-size="large"
						>
							<span class="icon-and-label-container">
								<IconFolder20 />
								<span class="label-container">
									<span class="label">Open</span>
								</span>
							</span>
						</button>
					</div>
				</div>

				<div
					data-restrict-mode="assessment"
					data-restrict-status="in-progress"
				>
					<p>
						The <em
							><span data-field="reportYear"></span><span> </span>
							<span data-field="reportSchool"></span><span> Assessment</span>
						</em> is currently <strong>In Progress</strong>. To view the report, its
						status must be set to <strong>Complete</strong>.
					</p>
					<div class="button-group">
						<button
							class="open-dialog"
							data-dialog="edit-status-dialog"
							data-dialog-context="configure"
							aria-label="Change Assessment Status"
							type="button"
							data-style="solid"
							data-size="large"
						>
							<span class="icon-and-label-container">
								<!-- <IconFolder20 /> -->
								<span class="label-container">
									<span class="label">Change Status</span>
								</span>
							</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<hr
			class="section"
			data-print="false"
			data-restrict-mode="assessment"
			data-restrict-status="complete"
			data-restrict-device-min="medium"
		/>

		<div
			id="digital-report-container"
			data-restrict-mode="assessment"
			data-restrict-status="complete"
			data-restrict-device-min="medium"
		>
			<section
				class="overview"
				data-tag="0"
				data-include="true"
			>
				<h2 id="overview">Overview</h2>
				<h3>Indicator Progress</h3>
				<MatrixChart
					entries={indicators}
					scope={'Indicators'}
				/>
				<h3>Component Progress</h3>
				<BarChart />
			</section>

			{
				indicators.map((indicator) => {
					// Get all current indicator components
					let components = allComponents
						.filter((component) => component.data.indicator === indicator.id)
						.sort((a, b) => a.data.tag.localeCompare(b.data.tag));

					return (
						<>
							<hr
								class="section"
								data-print="false"
							/>

							<section
								class="indicator"
								data-tag={indicator.data.tag}
								data-theme={indicator.data.colour}
								data-vibrancy="vivid"
								data-include="true"
							>
								<h2 id={`indicator-${indicator.data.tag}`}>
									<span class="title">{indicator.data?.title}</span>
								</h2>
								<h3>Overall Progress</h3>
								<ProgressChart colour={indicator.data.colour} />
								<h3>Component Progress</h3>
								<MatrixChart
									entries={components}
									scope={'Components'}
									colour={indicator.data.colour}
								/>
							</section>
						</>
					);
				})
			}
		</div>

		<div
			id="print-report-container"
			data-theme-fixed
		>
			<section
				class="cover"
				data-include="true"
				data-theme="red"
			>
				<div class="title-container">
					<Image
						src={gnbLogo}
						alt="Government of New Brunswick Logo"
					/>
					<h1>New Brunswick Middle Schools</h1>
					<p
						class="subtitle"
						data-font-type="serif"
					>
						Conditions for Success Developmental Continuums
					</p>
				</div>

				<div class="meta-container">
					<p
						data-field="school"
						data-style-as="h2"
					>
						School Name
					</p>
					<p data-style-as="h3"><span data-field="reportingYear"></span> Report</p>
					<p>
						Assessment Completed: <span data-field="assessmentCompletionDate"></span>
					</p>
					<p>Report Generated: <span data-field="reportGenerationDate"></span></p>
				</div>
			</section>

			<section
				class="overview"
				data-tag="0"
				data-include="true"
			>
				<h2 id="overview">Overview</h2>
				<h3>Indicator Progress</h3>
				<MatrixChart
					entries={indicators}
					scope={'Indicators'}
				/>
				<h3>Component Distribution</h3>
				<BarChart />
			</section>

			<section
				class="snapshot"
				data-include="true"
			>
				<h3>Component Progress</h3>
				<MatrixChart
					entries={components.filter((component) => Number(component.data.tag) < 6)}
					scope={'Components'}
					fit={'compact'}
				/>
			</section>

			<section
				class="snapshot"
				data-include="true"
			>
				<h3>Component Progress (Continued)</h3>
				<MatrixChart
					entries={components.filter((component) => Number(component.data.tag) >= 6)}
					scope={'Components'}
					fit={'compact'}
				/>
			</section>

			{
				indicators.map((indicator) => {
					// Get all current indicator components
					let components = allComponents
						.filter((component) => component.data.indicator === indicator.id)
						.sort((a, b) => a.data.tag.localeCompare(b.data.tag));

					return (
						<section
							class="indicator"
							data-tag={indicator.data.tag}
							data-include="true"
							data-theme={indicator.data.colour}
							data-vibrancy="vivid"
						>
							<h2 id={`indicator-${indicator.data.tag}`}>
								<span class="title">{indicator.data?.title}</span>
							</h2>
							<h3>Overall Progress</h3>
							<ProgressChart colour={indicator.data.colour} />
							<h3>Component Progress</h3>
							<MatrixChart
								entries={components}
								scope={'Components'}
								colour={indicator.data.colour}
							/>
						</section>
					);
				})
			}
		</div>
	</div>
</BaseLayout>

<style is:global>
	/* 
	// Device Restrictions
	*/

	@container main (width < 720px) {
		.content.report [data-restrict-device-min='medium'] {
			display: none !important;
		}
	}

	@container main (width >= 720px) {
		.content.report [data-restrict-device-max='small'] {
			display: none !important;
		}
	}

	/* 
	// Page Heading
	*/

	main.report {
		& h1 .subtitle {
			display: block;
			font-weight: 400;
			font-size: var(--font-size-xl);
			color: var(--colour-txt-on-subtle-2);
			margin: var(--space-2xs) 0 0;
		}

		/* 
		// Welcome Container Buttons
		*/

		& .welcome-container {
			& .button-group {
				margin: var(--space-lg) 0 0;
			}

			:is(button, [data-style-as='button']) {
				--container-gap: var(--space-xs);
				--label-size: var(--font-size-xs);
				--icon-size: 1.25rem;

				&:is(:hover, :focus-visible) {
					--label-colour: var(--colour-txt-on-bold-1);
					--icon-colour: var(--colour-txt-on-bold-1);
				}
			}
		}

		& #report-controls {
			--group-gap: var(--space-2xs);
			display: inline-flex;
			flex-flow: row wrap;
			align-items: center;
			gap: var(--space-2xs);
			min-height: 3.25rem;
			padding: var(--space-2xs);
			margin: var(--space-sm) 0 0;
			background-color: var(--colour-bkg-surface-subtle-1);
			border-radius: var(--brd-radius-normal);

			& :is(button, [data-style-as='button']) {
				--icon-size: 1.25rem;
				--button-bkg-colour: transparent;

				&:is(:hover, :focus-visible) {
					--icon-colour: var(--colour-txt-on-bold-1);
					--label-colour: var(--colour-txt-on-bold-1);
					--button-bkg-colour: var(--colour-bkg-surface-bold-1);
				}
			}

			& .separator.item {
				--separator-long-edge-dimension: 1.75rem;
			}
		}

		& #digital-report-container {
			position: relative;

			& > section {
				width: 100%;
			}

			& h3 {
				font-weight: 500;
			}

			& hr:has(+ section[hidden]) {
				display: none;
			}
		}

		& #print-report-container {
			width: 816px !important;
			margin: 0 auto;
			background-color: #ffffff;
			color: var(--colour-txt-on-subtle-1);
			position: fixed;
			top: 0;
			left: -9999px;
			overflow: visible;
			pointer-events: none;

			& section {
				box-sizing: border-box !important;
				width: 816px !important;
				min-height: 1056px !important;
				padding: 48px !important;
				background-color: #ffffff;
				position: relative;
				overflow: hidden;

				page-break-before: always;
				page-break-after: always;
				break-before: page;
				break-after: page;

				& :is(h3, [data-style-as='h3']) {
					font-weight: 500;
				}

				&.cover {
					display: flex;
					flex-flow: column;
					justify-content: space-between;
					padding-top: 2.5in;

					& .title-container {
						& img {
							height: 48px;
							width: auto;
						}

						& h1 {
							font-size: var(--font-size-3xl);
							margin: var(--space-xl) 0 var(--space-sm);
						}

						& .subtitle {
							display: inline-block;
							font-size: var(--font-size-lg);
							font-weight: 500;
							line-height: 1;
							color: var(--colour-txt-on-bold-1);
							background-color: var(--colour-bkg-surface-bold-1-accent);
							border-radius: var(--brd-radius-normal);
							padding: var(--space-sm) var(--space-base);
						}
					}
				}

				& .meta-container {
					&
						:is(
							:has([data-field='reportGenerationDate']),
							:has([data-field='assessmentCompletionDate'])
						) {
						font-size: var(--font-size-xs);
						margin: 0;
					}

					& [data-field='school'] {
						margin: 0 0 var(--space-xs);
					}

					& :has([data-field='reportingYear']) {
						margin: 0 0 var(--space-2xl);
					}
				}

				[data-screen-reader] {
					display: none !important;
				}
			}
		}

		hr:has(+ #digital-report-container[hidden]) {
			display: none;
		}

		& #pdf-export-progress-container {
			width: 100%;
			max-width: 400px;
			margin: var(--space-lg) 0 0;

			& .text-container {
				font-size: var(--font-size-xs);
				color: var(--colour-txt-on-subtle-2);
				margin: 0 0 var(--space-xs);
			}

			& [role='progressbar'] {
				width: 100%;
				height: 1rem;
				border-radius: var(--brd-radius-normal);
				background-color: var(--colour-bkg-surface-subtle-1);
				overflow: hidden;

				& [data-role='bar'] {
					width: 0%;
					height: 100%;
					background-color: var(
						--colour-bkg-surface-bold-1-accent,
						var(--colour-bkg-surface-bold-1)
					);
				}
			}
		}
	}
</style>

<script>
	//
	// Imports
	//

	import { userDataStore, subscribe } from 'src/stores/userDataStore';
	import { getActiveAssessmentData } from 'src/stores/userDataStore';

	//
	// Methods
	//

	//
	// DOM Updates
	//

	let updateReport = async (data: UserData, changes) => {
		let digitalReportContainer = document.querySelector('#digital-report-container');
		let printReportContainer = document.querySelector('#print-report-container');
		if (!digitalReportContainer) return;

		let stateTriggerKeys = ['activeAssessmentId'];
		let preferencesTriggerKeys = ['reportIncludedIndicators'];
		let assessmentTriggerKeys = ['school', 'reportingYear', 'continuumCompletion'];
		if (
			!changes.initiating &&
			!(
				(changes.assessments &&
					assessmentTriggerKeys.some((val) => changes.assessments.includes(val))) ||
				(changes.uiPreferences &&
					preferencesTriggerKeys.some((val) => changes.uiPreferences.includes(val))) ||
				(changes.uiState && stateTriggerKeys.some((val) => changes.uiState.includes(val)))
			)
		)
			return;

		let main = document.querySelector('main');
		let sections = [
			...digitalReportContainer?.querySelectorAll(':scope > section'),
			...printReportContainer?.querySelectorAll(':scope > section'),
		];
		let onPageNav = document.querySelector('nav.on-page');

		let reportHeading = document.querySelector('h1');
		let reportHeadingSubtitle = reportHeading?.querySelector('.subtitle');
		let reportHeadingSchool = reportHeading?.querySelector('[data-field="reportSchool"]');
		let reportHeadingYear = reportHeading?.querySelector('[data-field="reportYear"]');

		let reportWelcome = document.querySelector('main.report .welcome-container');
		let reportWelcomeSchool = reportWelcome?.querySelector('[data-field="reportSchool"]');
		let reportWelcomeYear = reportWelcome?.querySelector('[data-field="reportYear"]');

		if (!data.uiState.activeAssessmentId) {
			main.setAttribute('data-report', 'inactive');
			reportHeadingSubtitle.setAttribute('hidden', '');
		} else {
			let assessment = getActiveAssessmentData();
			if (!assessment) return;

			main.setAttribute('data-report', 'active');

			let onPageNavLinks = onPageNav.querySelectorAll('a');
			for (let link of onPageNavLinks) {
				if (link.getAttribute('data-tag') === '0') continue;
				if (
					data.uiPreferences.reportIncludedIndicators.includes(
						link.getAttribute('data-tag'),
					)
				)
					link.closest('li').removeAttribute('hidden');
				else link.closest('li').setAttribute('hidden', '');
			}

			reportHeadingSchool.textContent = assessment.school;
			reportHeadingYear.textContent = assessment.reportingYear;
			reportHeadingSubtitle.removeAttribute('hidden');

			reportWelcomeSchool.textContent = assessment.school;
			reportWelcomeYear.textContent = assessment.reportingYear;

			for (let section of sections) {
				let mainScopeTag = section.getAttribute('data-tag');
				let mainScopeCompletion =
					mainScopeTag === '0'
						? assessment.continuumCompletion.continuum
						: assessment.continuumCompletion[mainScopeTag];

				let progressChart = section.querySelector('.progress');
				let progressSimplified = section.querySelector('.progress-simplified');
				if (progressChart) {
					let progressChartSegments =
						progressChart.querySelectorAll('.segment-container');
					let progressSimDetails = progressSimplified.querySelectorAll('dd');
					let progressSimPhaseField =
						progressSimplified.querySelector('[data-field="phase"]');

					for (let [index, segment] of Object.entries(progressChartSegments)) {
						let phase = segment.getAttribute('data-phase');

						let activePhase = mainScopeCompletion
							? mainScopeCompletion.phase.toLowerCase()
							: 'initiating';

						if (phase.toLowerCase() === activePhase) {
							segment.setAttribute('data-active', '');
							progressSimPhaseField.textContent =
								phase.charAt(0).toUpperCase() + phase.slice(1);
						} else {
							segment.removeAttribute('data-active');
						}

						let countField = segment.querySelector('[data-field="count"]');
						let totalField = segment.querySelector('[data-field="total"]');
						let progressSimCountField =
							progressSimDetails[index].querySelector('[data-field="count"]');
						let progressSimTotalField =
							progressSimDetails[index].querySelector('[data-field="total"]');

						let phaseTotal;
						if (!mainScopeCompletion) {
							let count = await userDataStore.getConsiderationCount();
							phaseTotal =
								mainScopeTag === '0'
									? count.continuum[phase]
									: count[mainScopeTag][phase];
						}

						countField.textContent = mainScopeCompletion
							? mainScopeCompletion[`${phase}Count`]
							: 0;
						totalField.textContent = mainScopeCompletion
							? mainScopeCompletion[`${phase}Total`]
							: phaseTotal;
						progressSimCountField.textContent = mainScopeCompletion
							? mainScopeCompletion[`${phase}Count`]
							: 0;
						progressSimTotalField.textContent = mainScopeCompletion
							? mainScopeCompletion[`${phase}Total`]
							: phaseTotal;
					}
				}

				let matrixCharts = section.querySelectorAll('.matrix');
				for (let matrix of matrixCharts) {
					let matrixChartScope = matrix.getAttribute('data-scope');
					let matrixChartRows = matrix.querySelectorAll('tr');
					let matrixSimplified = section.querySelector('.matrix-simplified');
					let matrixSimRows = matrixSimplified.querySelectorAll('tr');
					let matrixSimScopeField =
						matrixSimplified.querySelector('[data-field="scope"]');
					matrixSimScopeField.textContent = matrixChartScope;

					for (let [index, row] of Object.entries(matrixChartRows)) {
						let subScopeTag = row.getAttribute('data-tag');

						let subScopeCompletion = assessment.continuumCompletion[subScopeTag];

						if (!subScopeCompletion) continue;

						row.setAttribute('data-phase', subScopeCompletion.phase.toLowerCase());

						let matrixSimRow = matrixSimRows[index];
						let matrixSimPhaseField =
							matrixSimRow.querySelector('[data-field="phase"]');
						matrixSimPhaseField.textContent = subScopeCompletion.phase;
					}
				}

				let barChart = section.querySelector('.bar');
				let barSimplified = section.querySelector('.bar-simplified');
				if (barChart) {
					let barChartSegments = barChart.querySelectorAll(
						'.segment-container',
					) as NodeListOf<HTMLElement>;
					let barSimDetails = barSimplified.querySelectorAll('p');

					for (let [index, segment] of Object.entries(barChartSegments)) {
						let phase = segment.getAttribute('data-phase');

						let countField = segment.querySelector('[data-field="count"]');
						let totalField = segment.querySelector('[data-field="total"]');
						let barSimCountField =
							barSimDetails[index].querySelector('[data-field="count"]');
						let barSimTotalField =
							barSimDetails[index].querySelector('[data-field="total"]');

						countField.textContent = mainScopeCompletion
							? mainScopeCompletion[`${phase}Components`]
							: 0;
						totalField.textContent = mainScopeCompletion
							? mainScopeCompletion[`components`]
							: 0;
						barSimCountField.textContent = mainScopeCompletion
							? mainScopeCompletion[`${phase}Components`]
							: 0;
						barSimTotalField.textContent = mainScopeCompletion
							? mainScopeCompletion[`components`]
							: 0;

						segment.style.setProperty(
							'--total',
							mainScopeCompletion ? mainScopeCompletion[`components`] : 0,
						);
						segment.style.setProperty(
							'--count',
							mainScopeCompletion ? mainScopeCompletion[`${phase}Components`] : 0,
						);
					}
				}

				let reportIncludedIndicators = data.uiPreferences.reportIncludedIndicators;

				if (section.matches('.indicator')) {
					if (reportIncludedIndicators.includes(mainScopeTag)) {
						section.removeAttribute('hidden');
						section.setAttribute('data-include', '');
					} else {
						section.setAttribute('hidden', '');
						section.removeAttribute('data-include');
					}
				}
			}
		}
	};

	//
	// Inits
	//

	subscribe(updateReport);
</script>
