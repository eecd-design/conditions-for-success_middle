---
import IconWarningBig from 'src/components/icons/IconWarning_24.astro';
import IconCopy from 'src/components/icons/IconCopy_20.astro';
import IconXmark from 'src/components/icons/IconXmark_20.astro';
import Toast from 'src/components/Toast.astro';
import IconCheckmark from '../icons/IconCheckmark_12.astro';
import IconXmarkInCircle from 'src/components/icons/IconXmarkInCircle_16.astro';
---

<dialog
	id="share-assessment-dialog"
	aria-describedby="share-assessment-dialog_heading"
>
	<div class="heading-container">
		<button
			class="close-dialog"
			type="button"
			aria-label="Close Share Assessment Dialog"
			><IconXmark /></button
		>
		<h2
			id="share-assessment-dialog_heading"
			class="heading"
		>
			Share Assessment
		</h2>
	</div>

	<p class="instructions">
		Copy and share this save code to collaborate on this assessment. The collaborator can use
		the save code to import the assessment in the <button
			class="open-dialog"
			data-dialog="manage-assessments-dialog"
			type="button"
			data-style-as="link"
			>Manage Assessments Dialog
		</button> and continue working on it.
	</p>

	<div
		class="callout"
		data-style="solid"
		data-vibrancy="vivid"
		data-fit="compact"
		data-theme="yellow"
	>
		<div class="wrapper">
			<div class="icon-container">
				<IconWarningBig />
			</div>
			<div class="text-container">
				<p>
					The information stored in this code represents a snapshot of this assessment as
					it is now. <strong
						>It will not automatically update if any changes are made after copying it.</strong
					>
				</p>
			</div>
		</div>
	</div>

	<section>
		<h3>Save Code</h3>
		<div
			class="code-container"
			data-style-as="input-container"
		>
			<div
				class="url"
				data-style-as="input"
			>
				<span data-field="exportCode"></span>
			</div>
			<button
				class="copy-code"
				type="button"
				aria-label="Copy assessment code to clipboard"
				data-toast-success="share-assessment-dialog_copy-code-toast_success"
				data-toast-failure="share-assessment-dialog_copy-code-toast_failure"
			>
				<span class="icon-and-label-container">
					<IconCopy />
					<span class="label-container">
						<span class="label">Copy</span>
					</span>
				</span>
			</button>
		</div>
	</section>

	<div class="toast-group">
		<Toast
			id={'share-assessment-dialog_copy-code-toast_success'}
			message={'Export code copied to the clipboard.'}
			colour={'green'}
			type={'success'}
		>
			<IconCheckmark slot={'icon'} />
		</Toast>
		<Toast
			id={'share-assessment-dialog_copy-code-toast_failure'}
			message={`Unable to copy export code. Please reload the page to try again.`}
			colour={'red'}
			type={'failure'}
		>
			<IconXmarkInCircle slot={'icon'} />
		</Toast>
	</div>
</dialog>

<dialog
	id="download-assessment-dialog"
	aria-describedby="download-assessment-dialog_heading"
>
	<div class="heading-container">
		<button
			class="close-dialog"
			type="button"
			aria-label="Close Download Assessment Dialog"
			><IconXmark /></button
		>
		<h2
			id="download-assessment-dialog_heading"
			class="heading"
			data-default-text="Download Assessment"
		>
			Download Assessment
		</h2>
	</div>

	<!-- <section class="edit-status">
		<h3>Update Status Before Export</h3>
		<p
			id="download-assessment-dialog_edit-status_in-progress-instructions"
			class="instructions"
		>
			This assessment is marked as <strong>In Progress</strong>. Mark it as <strong
				>Complete</strong
			> before exporting?
		</p>
		<p
			id="download-assessment-dialog_edit-status_complete-instructions"
			class="instructions"
			hidden
		>
			This assessment is marked as <strong>Complete</strong>. Mark it as <strong
				>In Progress</strong
			> before exporting?
		</p>

		<div class="button-group">
			<button
				class="change-status"
				type="button"
				data-style="solid"
				data-size="large"
				data-toast-success="download-assessment-dialog_change-status-toast_success"
				data-toast-failure="download-assessment-dialog_change-status-toast_failure"
				aria-describedby="download-assessment-dialog_edit-status_in-progress-instructions"
				data-focus-start
				>Mark as Complete</button
			>
		</div>
	</section> -->
	<!-- 
	<hr class="group" /> -->

	<p class="instructions">
		Download a copy of this assessment to backup your work. You can use this file to restore the
		assessment in the <button
			class="open-dialog"
			data-dialog="manage-assessments-dialog"
			type="button"
			data-style-as="link"
			>Manage Assessments Dialog
		</button> on this device or another.
	</p>

	<div
		class="callout"
		data-style="solid"
		data-vibrancy="vivid"
		data-fit="compact"
		data-theme="yellow"
	>
		<div class="wrapper">
			<div class="icon-container">
				<IconWarningBig />
			</div>
			<div class="text-container">
				<p>Editing backup files can break formatting and prevent importing.</p>
			</div>
		</div>
	</div>

	<div class="button-group">
		<button
			class="download-assessment download-file"
			type="button"
			data-style="solid"
			data-size="large"
			aria-label="Download assessment data as CSV file"
			data-toast-success="download-assessment-dialog_export-file-toast_success"
			data-toast-failure="download-assessment-dialog_export-file-toast_failure"
			>Download File</button
		>
	</div>

	<div class="toast-group">
		<Toast
			id={'download-assessment-dialog_change-status-toast_success'}
			message={`Status change saved.`}
			colour={'green'}
			type={'success'}
		>
			<IconCheckmark slot={'icon'} />
		</Toast>
		<Toast
			id={'download-assessment-dialog_change-status-toast_failure'}
			message={`Unable to change status. Please reload the page to try again.`}
			colour={'red'}
			type={'failure'}
		>
			<IconXmarkInCircle slot={'icon'} />
		</Toast>

		<Toast
			id={'download-assessment-dialog_export-file-toast_success'}
			message={`File exported!`}
			colour={'green'}
			type={'success'}
		>
			<IconCheckmark slot={'icon'} />
		</Toast>
		<Toast
			id={'download-assessment-dialog_export-file-toast_failure'}
			message={`Unable to export file. Please reload the page to try again.`}
			colour={'red'}
			type={'failure'}
		>
			<IconXmarkInCircle slot={'icon'} />
		</Toast>
	</div>
</dialog>

<dialog
	id="backup-warning-dialog"
	aria-describedby="backup-warning-dialog_heading"
>
	<div class="heading-container">
		<button
			class="close-dialog"
			type="button"
			aria-label="Close Warning Dialog"
			data-toast-success="backup-warning-dialog_close-toast_success"
			data-toast-failure="backup-warning-dialog_close-toast_failure"
			><IconXmark /></button
		>
		<h2
			id="backup-warning-dialog_heading"
			class="heading"
		>
			Backup Your Work?
		</h2>
	</div>

	<p class="instructions">
		Your changes are saved in the browser only. <span
			class="field-container"
			hidden
			><strong><span data-field="exportStatus"></span></strong></span
		>
	</p>
	<p class="instructions">
		Remember to download a backup of your assessment regularly to keep your data safe and
		restore it if needed.
	</p>

	<p class="instructions">Would you like to download a backup before you stop editing?</p>

	<div class="button-group">
		<button
			class="close-dialog"
			type="button"
			data-size="large"
			data-style="outline"
			data-toast-success="backup-warning-dialog_close-toast_success"
			data-toast-failure="backup-warning-dialog_close-toast_failure"
			data-focus-start
			>Continue Without Downloading</button
		>
		<button
			class="open-dialog"
			data-dialog="download-assessment-dialog"
			type="button"
			data-size="large"
			data-style="solid"
			>Download Backup</button
		>
	</div>

	<div class="toast-group">
		<Toast
			id={'edit-status-dialog_change-status-and-warn-toast_success'}
			message={`Status change saved.`}
			colour={'green'}
			type={'success'}
		>
			<IconCheckmark slot={'icon'} />
		</Toast>
		<!-- Success toast in Assessment Dialogs -->
		<Toast
			id={'backup-warning-dialog_close-toast_failure'}
			message={`Unable to close assessment. Please reload the page to try again.`}
			colour={'red'}
			type={'failure'}
		>
			<IconXmarkInCircle slot={'icon'} />
		</Toast>
	</div>
</dialog>

<script>
	//
	// Imports
	//

	import {
		compressData,
		getActiveAssessmentData,
		getAssessmentDate,
		setState,
		setAssessment,
		exportAssessment,
		subscribe,
		getExportStatus,
		updateChangeLog,
	} from 'src/stores/userDataStore';
	import { eventControl } from 'src/utilities/event';
	import { toastControl } from 'src/utilities/toast';

	/**
	 * Copy text to the user's clipboard
	 * @param  {String} text The text to copy
	 */
	let copyToClipboard = async (text) => {
		// Copy the text
		await navigator.clipboard.writeText(text);
	};

	//
	// DOM Updates
	//

	/**
	 * Update the manage-assessments dialog UI from stored assessment data
	 * @param data
	 */
	let updateDownloadAssessmentDialog = (data: UserData, changes) => {
		let dialog = document.querySelector('#download-assessment-dialog') as HTMLDialogElement;
		if (!dialog) return;

		let stateTriggerKeys = ['activeAssessmentId'];
		if (
			!changes.initiating &&
			!(
				changes.assessments ||
				(changes.uiState && stateTriggerKeys.some((val) => changes.uiState.includes(val)))
			)
		)
			return;

		if (!changes.initiating && !changes.assessments) return;

		// let assessment = getActiveAssessmentData();
		// if (!assessment) return;

		// editStatusSection({ dialog, status: assessment.status });
	};

	let updateShareAssessmentDialog = (data: UserData, changes) => {
		let dialog = document.querySelector('#share-assessment-dialog') as HTMLDialogElement;
		if (!dialog) return;

		let stateTriggerKeys = ['activeAssessmentId'];
		if (
			!changes.initiating &&
			!(
				changes.assessments ||
				(changes.uiState && stateTriggerKeys.some((val) => changes.uiState.includes(val)))
			)
		)
			return;

		if (!changes.initiating && !changes.assessments) return;

		let assessment = getActiveAssessmentData();
		if (!assessment) return;

		let exportCodeSection = dialog.querySelector('section.export-code');
		let codeField = dialog.querySelector('[data-field="exportCode"]');

		// Compress the assessment data into the export code
		let exportCode = compressData(assessment);

		// If compression is successful, inject code into field
		if (exportCode) {
			codeField.textContent = exportCode;

			// Otherwise, hide the section
		} else {
			exportCodeSection.setAttribute('hidden', '');
		}
	};

	let editStatusSection = ({ dialog, status }) => {
		if (!dialog || !status) return;

		let isComplete = status === 'Complete';

		let completeInstructions = dialog.querySelector(
			'#download-assessment-dialog_edit-status_complete-instructions',
		);
		let inProgressInstructions = dialog.querySelector(
			'#download-assessment-dialog_edit-status_in-progress-instructions',
		);
		completeInstructions.toggleAttribute('hidden', !isComplete);
		inProgressInstructions.toggleAttribute('hidden', isComplete);

		let btn = dialog.querySelector('section.edit-status button.change-status');

		btn.textContent = isComplete ? 'Mark as In Progress' : 'Mark as Complete';
		btn.setAttribute(
			'aria-describedby',
			isComplete
				? 'download-assessment-dialog_edit-status_complete-instructions'
				: 'download-assessment-dialog_edit-status_in-progress-instructions',
		);
	};

	let updateExportWarningDialog = (data: UserData, changes) => {
		let dialog = document.querySelector('#backup-warning-dialog') as HTMLDialogElement;
		if (!dialog) return;

		let stateTriggerKeys = ['activeAssessmentId'];
		let assessmentTriggerKeys = ['unexportedChanges', 'dateExported'];
		if (
			!changes.initiating &&
			!(
				(changes.assessments &&
					assessmentTriggerKeys.some((val) => changes.assessments.includes(val))) ||
				(changes.uiState && stateTriggerKeys.some((val) => changes.uiState.includes(val)))
			)
		)
			return;

		let assessment = getActiveAssessmentData();
		if (!assessment) return;

		let exportStatusField = dialog.querySelector('[data-field="exportStatus"]');
		let exportStatusFieldContainer = exportStatusField?.closest('.field-container');

		if (!exportStatusField || !exportStatusFieldContainer) return;

		let timeSinceExport = getExportStatus({ verbose: false }) as number;
		let exportStatus =
			timeSinceExport === 0 ? null : `It's been ${timeSinceExport} since your last backup.`;

		if (exportStatus) {
			exportStatusField.innerHTML = exportStatus;
			exportStatusFieldContainer.removeAttribute('hidden');
		} else {
			exportStatusFieldContainer.setAttribute('hidden', '');
		}
	};

	//
	// Inits
	//

	// subscribe(updateDownloadAssessmentDialog);
	subscribe(updateShareAssessmentDialog);
	subscribe(updateExportWarningDialog);

	//
	// Event Listeners
	//

	let onExportAssessmentClick = async (event) => {
		let target = event.target as HTMLButtonElement;

		let dialog = target.closest('dialog');
		if (!dialog) return;

		if (target.matches('button.change-status')) {
			try {
				let assessment = getActiveAssessmentData();

				let { status } = assessment;
				let newStatus = status === 'In Progress' ? 'Complete' : 'In Progress';

				setAssessment({
					status: newStatus,
					dateModified: Date.now(),
					changeLog: updateChangeLog({
						changeLog: assessment.changeLog,
						message: `updated assessment status to ${newStatus.toLowerCase()}.`,
					}),
				});

				toastControl.show({ target, type: 'success' });
			} catch (error) {
				console.error(error);
				toastControl.show({ target, type: 'failure' });
			}
		}

		if (target.matches('button.download-file')) {
			try {
				exportAssessment(getActiveAssessmentData());

				setAssessment({
					unexportedChanges: false,
					dateExported: Date.now(),
				});

				toastControl.show({ target, type: 'success' });
			} catch (error) {
				console.error(error);
				toastControl.show({ target, type: 'failure' });
			}
		}

		if (target.matches('button.copy-code')) {
			try {
				let codeField = target.closest('dialog').querySelector('[data-field="exportCode"]');

				copyToClipboard(codeField.textContent);

				toastControl.show({ target, type: 'success' });
			} catch (error) {
				console.error(error);
				toastControl.show({ target, type: 'failure' });
			}
		}
	};
	eventControl.add({
		selector: '#download-assessment-dialog',
		eventType: 'click',
		fn: onExportAssessmentClick,
	});

	let onExportWarningClick = (event) => {
		let target = event.target as HTMLButtonElement;

		let dialog = target.closest('dialog');
		if (!dialog) return;

		if (target.matches('button.close-dialog')) {
			try {
				setAssessment({
					activeAssessor: null,
				});
				setState({
					mode: 'reading',
					activeAssessmentId: null,
				});
				// Reset consideration checkboxes
				for (let input of document.querySelectorAll(
					'input[name="considerationsEstablished"]',
				) as NodeListOf<HTMLInputElement>) {
					input.checked = false;
				}

				toastControl.show({ target, type: 'success' });
			} catch (error) {
				console.error(error);
				toastControl.show({ target, type: 'failure' });
			}
		}
	};
	eventControl.add({
		selector: '#backup-warning-dialog',
		eventType: 'click',
		fn: onExportWarningClick,
	});
</script>
