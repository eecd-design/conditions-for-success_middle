---
import Dialog from 'src/components/dialogs/Dialog.astro';
import IconExternal16 from '../icons/IconExternal_16.astro';
---

<Dialog
	id={'continuum-update-dialog'}
	title={'Continuum Update'}
>
	<Fragment slot="content">
		<p>
			<span data-restrict-context="load">The assessments saved in the browser have</span><span
				data-restrict-context="import">The imported assessment has</span
			> been updated to the newest version of the continuum (<span
				data-field="continuumVersion"></span>). Please note that this update includes text
			changes, additions, deletions, and the reordering of components and considerations. The
			numbering of certain components and considerations have changed as a result.
		</p>
		<p>No additional action is required.</p>
		<p>
			For a full list of changes, <a
				class="change-log-link"
				href={`./support/`}
				target="_blank"
				rel="noopener"
			>
				view the Continuum <span data-field="continuumVersion"></span> Change Log
				<IconExternal16 />
				<span data-screen-reader> (opens in a new tab)</span>
			</a>.
		</p>

		<div class="button-group">
			<button
				class="close"
				type="button"
				data-size="large"
				data-style="outline"
				data-focus-start
			>
				Dismiss
			</button>
		</div>
	</Fragment>
</Dialog>

<style is:global>
	#continuum-update-dialog {
		& .change-log-link {
			--icon-size: 0.875rem;
			--icon-colour: var(--colour-txt-on-subtle-2);
			& .icon {
				margin-left: var(--space-3xs);
			}
		}

		&:not([data-context='load']) [data-restrict-context='load'] {
			display: none !important;
		}
		&:not([data-context='import']) [data-restrict-context='import'] {
			display: none !important;
		}
	}
</style>

<script>
	//
	// Imports
	//

	import {
		checkForChanges,
		createAssessment,
		updateChangeLog,
		getActiveAssessmentData,
		getAssessmentData,
		getAssessmentDate,
		getStatusColour,
		setAssessment,
		subscribe,
		getUserData,
		duplicateAssessment,
	} from 'src/stores/userDataStore';
	import { dialogControl } from 'src/utilities/dialog';
	import { eventControl } from 'src/utilities/event';

	let updateContinuumUpdateDialog = (data: UserData, changes) => {
		let dialog = document.querySelector('#continuum-update-dialog') as HTMLDialogElement;
		if (!dialog) return;

		let stateTriggerKeys = ['currentContinuumVersion'];
		let assessmentTriggerKeys = [];
		if (
			!changes.initiating &&
			!(
				(changes.assessments &&
					assessmentTriggerKeys.some((val) => changes.assessments.includes(val))) ||
				(changes.uiState && stateTriggerKeys.some((val) => changes.uiState.includes(val)))
			)
		)
			return;

		let fields = dialog.querySelectorAll('data-field');

		for (let field of fields) {
			field.textContent = data.uiState.currentContinuumVersion;
		}

		let changeLogLink = dialog.querySelector('.change-log-link') as HTMLAnchorElement;
		if (changeLogLink)
			changeLogLink.href = `./support/continuum-${data.uiState.currentContinuumVersion.replaceAll('.', '')}/`;
	};

	//
	// Inits
	//

	subscribe(updateContinuumUpdateDialog);

	//
	// Event Listeners
	//

	let onClick = (event) => {
		let debug = false;

		let target = event.target as HTMLButtonElement;

		let dialog = target.closest('dialog');
		if (!dialog) return;

		if (target.matches('.close')) {
			if (dialog.dataset.context === 'import') {
				dialogControl.open({
					dialogId: 'manage-assessments-dialog',
					noBack: true,
				});
			}
		}
	};
	eventControl.add({
		selector: '#continuum-update-dialog',
		eventType: 'click',
		fn: onClick,
	});
</script>
