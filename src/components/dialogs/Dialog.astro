---
import IconXmark from 'src/components/icons/IconXmark_20.astro';
import IconArrowLeft from 'src/components/icons/IconArrowLeft_20.astro';

const { id, title, context = null, resetForms = false, dataset } = Astro.props;

let datasetAttrs = {};
if (dataset) {
	for (let data of dataset) {
		datasetAttrs[`data-${data.key}`] = data.value;
	}
}
---

<dialog
	id={id}
	aria-describedby={`${id}_heading`}
	data-reset-forms={resetForms}
	data-context={context}
	{...datasetAttrs}
>
	<div class="heading-container">
		<div class="dialog-controls button-group">
			<button
				class="back-dialog"
				type="button"
				aria-label="Return to previous dialog"
				hidden
				><IconArrowLeft /></button
			>
			<button
				class="close-dialog"
				type="button"
				aria-label={`Close ${title} Dialog`}
				><IconXmark /></button
			>
		</div>
		<h2
			id={`${id}_heading`}
			class="heading"
			data-default-text={title}
		>
			{title}
		</h2>
	</div>

	<slot name="content" />

	{
		Astro.slots.has('toasts') && (
			<div class="toast-group">
				<slot name="toasts" />
			</div>
		)
	}
</dialog>

<style is:global>
	dialog {
		background-color: var(--colour-bkg-canvas-subtle-1);
		border-radius: var(--brd-radius-normal);
		border: none;
		padding: var(--space-2xl);
		width: min(100%, 636px);
		max-height: calc(100% - 4rem);
		max-width: calc(100% - 2rem);
		z-index: 200;

		@container body (width < 744px) {
			border-radius: 0;
			max-width: 100%;
			max-height: 100%;
			padding: var(--space-xl);
			width: 100%;
			height: 100%;
			margin: 0 !important;
		}

		&[data-intensity='bold'] {
			--dialog-txt-colour: var(--colour-txt-on-bold-1);
			background-color: var(
				--colour-bkg-surface-bold-1-accent,
				var(--colour-bkg-surface-bold-1)
			);
			color: var(--dialog-txt-colour);

			& button.close-dialog:has(.icon:only-child):is(:hover, :focus-visible) {
				--button-bkg-colour: var(--colour-bkg-canvas-subtle-1);
				--icon-colour: var(--colour-txt-on-subtle-1);
			}
		}

		&:focus {
			outline: none;
			caret-color: transparent;
		}

		&::backdrop {
			background-color: var(--colour-bkg-surface-bold-1);
			opacity: 0.8;
			pointer-events: none;
			z-index: 199;
		}

		:root[data-theme='dark'] &::backdrop {
			background-color: var(--colour-bkg-surface-subtle-1);
		}

		& .dialog-controls.button-group {
			--group-gap: var(--space-xs);
			margin: 0 0 var(--space-sm) var(--space-lg);
			float: right;

			& button:is(.close-dialog, .back-dialog) {
				--button-bkg-colour: transparent;
				--icon-size: 1.25rem;
				--icon-colour: var(--dialog-txt-colour, inherit);
				min-width: 2.25rem;

				&:is(:hover, :focus-visible) {
					--button-bkg-colour: var(--colour-bkg-surface-bold-2);
					--icon-colour: var(--colour-txt-on-bold-1);
				}
			}
		}

		& section {
			margin: var(--space-lg) 0;

			&:has(.elem-group:empty) {
				display: none;
			}

			& > h3 {
				font-weight: 500;
				margin: var(--space-sm) 0;
			}
		}

		& .heading-container {
			width: 100%;
			margin: 0 0 var(--space-lg);
			padding: 0 0 var(--space-sm);
			border-bottom: 2px solid var(--dialog-txt-colour, var(--colour-brd-subtle));

			& .heading {
				margin: 0;
				color: var(--dialog-txt-colour, inherit);
			}
		}

		& :not(.callout *) {
			&:where(p, li) {
				font-size: var(--font-size-xs);
				line-height: 1.4;
				color: var(--colour-txt-on-subtle-2);
				margin: 0 0 var(--space-xs);
			}

			&:where(a, [data-style-as='link']) {
				--link-colour: var(--colour-txt-on-subtle-2);
				font-size: var(--font-size-xs);

				color: var(--colour-txt-on-subtle-2);
			}
		}

		& .callout {
			--callout-margin: var(--space-lg) 0;
		}

		& .button-group {
			margin: var(--space-lg) 0;
		}

		& hr.group {
			margin: var(--space-xl) 0;
		}

		& form hr.group {
			margin: var(--space-xs) 0;
		}

		& :has(+ .toast-group) {
			margin-bottom: 0 !important;
		}
	}
</style>
