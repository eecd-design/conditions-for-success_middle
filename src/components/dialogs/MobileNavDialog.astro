---
import { getCollection } from 'astro:content';

import Dialog from 'src/components/dialogs/Dialog.astro';

const { url } = Astro;
let path = url.pathname;
let base = import.meta.env.BASE_URL;

let allIndicators = await getCollection('indicators');
let indicators = allIndicators.sort((a, b) => a.data.tag.localeCompare(b.data.tag));
---

<Dialog
	id={'mobile-nav-dialog'}
	title={'Menu'}
	dataset={[
		{ key: 'intensity', value: 'bold' },
		{ key: 'theme', value: 'red' },
	]}
>
	<Fragment slot="content">
		<nav
			class="mobile"
			aria-label="Main navigation"
		>
			<ul class="nav-links-list">
				<li class="home-icon">
					<a
						class="nav-link"
						aria-current={path.endsWith(base) ? 'page' : null}
						href="./"
					>
						Home
					</a>
				</li>
				<li class="subnav-container">
					<span>The Big Seven</span>
					<ul class="subnav-links-list">
						<li>
							<a
								class="subnav-link"
								aria-current={path.endsWith('/big-seven/') ? 'page' : null}
								href={`./big-seven/`}
							>
								Introduction
							</a>
						</li>
						{
							indicators.map((indicator) => {
								let indicatorPath = `./big-seven/${indicator.id}/`;
								return (
									<li>
										<a
											class="subnav-link"
											aria-current={
												path.endsWith(`/${indicator.id}/`) ? 'page' : null
											}
											href={indicatorPath}
										>
											{indicator.data.tag}.&ensp;{indicator.data.title}
										</a>
									</li>
								);
							})
						}
					</ul>
				</li>
				<li>
					<a
						class="nav-link"
						aria-current={path.includes('/resources/') ? 'page' : null}
						href={`./resources/`}
					>
						Resources
					</a>
				</li>
				<li>
					<a
						class="nav-link"
						aria-current={path.includes('/training/') ? 'page' : null}
						href={`./training/`}
						>Training</a
					>
				</li>
				<li>
					<a
						class="nav-link"
						aria-current={path.includes('/report/') ? 'page' : null}
						href={`./report/`}
					>
						Report
					</a>
				</li>
				<li>
					<a
						class="nav-link"
						aria-current={path.includes('/support/') ? 'page' : null}
						href={`./support/`}
						>Support</a
					>
				</li>
			</ul>
		</nav>
	</Fragment>
</Dialog>

<style is:global>
	#mobile-nav-dialog {
		border-radius: 0;
		max-width: 100%;
		max-height: 100%;
		padding: var(--space-xl);
		width: 100%;
		height: 100%;
		margin: 0 !important;

		& nav.mobile {
			margin: var(--space-xl) 0 0;

			& ul {
				display: flex;
				flex-flow: column;
				list-style-type: none;
				padding: 0;
				margin: 0;

				& li {
					line-height: 1;
					margin: 0;
				}
			}

			& .nav-links-list {
				gap: var(--space-xl);
			}

			& .subnav-container {
				& > span {
					display: inline-block;
					margin: 0 0 var(--space-lg);
					font-size: var(--font-size-base);
					font-weight: 600;
					color: var(--dialog-txt-colour);
				}

				& .subnav-links-list {
					padding: 0 0 0 var(--space-xl);
					border-left: 1px solid var(--colour-brd-subtle-accent);
					gap: var(--space-lg);

					& .subnav-link {
						font-weight: 300;
					}
				}
			}

			& a {
				--link-colour: var(--dialog-txt-colour);
				color: var(--link-colour);
				font-size: var(--font-size-base);
				font-weight: 600;
				line-height: 1;
				width: 100%;

				& .icon.destination {
					--icon-colour: var(--dialog-txt-colour);
				}
			}
		}
	}
</style>
