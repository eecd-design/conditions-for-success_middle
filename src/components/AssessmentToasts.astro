---
import Toast from 'src/components/Toast.astro';
import IconWarning from 'src/components/icons/IconWarning_16.astro';
import IconCheckmark from 'src/components/icons/IconCheckmark_12.astro';
import IconXmarkInCircle from 'src/components/icons/IconXmarkInCircle_16.astro';
---

<Fragment slot="toast-group">
	<!-- Manage Assessments -->
	<Toast
		id={'manage-assessments-dialog_open-complete-toast_success'}
		message={`Assessment opened!`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>

	<!-- Edit Assessments -->
	<Toast
		id={'edit-assessment-properties-dialog_save-toast_success'}
		message={`Save successful!`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>

	<!-- Assessors -->
	<Toast
		id={'assessor-dialog_save-toast_success'}
		message={`Save successful!`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>

	<!-- Status -->
	<Toast
		id={'edit-status-dialog_change-status-toast_success'}
		message={`Save successful!`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>
	<Toast
		id={'edit-status-dialog_change-status-and-close-toast_success'}
		message={`Status change saved and assessment closed.`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>
	<Toast
		id={'edit-status-dialog_close-toast_success'}
		message={`Assessment closed.`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>

	<!-- Close -->
	<Toast
		id={'backup-warning-dialog_close-toast_success'}
		message={`Assessment closed.`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>
	<Toast
		id={'assessment-toolbar_close-toast_success'}
		message={`Assessment closed.`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>
	<Toast
		id={'assessment-toolbar_close-toast_failure'}
		message={`Unable to close assessment. Please reload the page to try again.`}
		colour={'red'}
		type={'failure'}
	>
		<IconXmarkInCircle slot={'icon'} />
	</Toast>

	<!-- Report Settings -->
	<Toast
		id={'report-settings-dialog_save-toast_success'}
		message={`Report settings saved!`}
		colour={'green'}
		type={'success'}
	>
		<IconCheckmark slot={'icon'} />
	</Toast>

	<!-- Data Entry -->
	<Toast
		id={'big-seven_data-entry-toast_reminder'}
		message={`Remember to check off considerations in previous phases to ensure accurate reporting.`}
		colour={'yellow'}
		type={'reminder'}
	>
		<IconWarning slot={'icon'} />
	</Toast>
</Fragment>
