---
import IconCross from './icons/IconCross_20.astro';
import IconInfo from './icons/IconInfo_20.astro';
import IconFolder from './icons/IconFolder_20.astro';
import IconSave from './icons/IconSave_20.astro';
import IconEdit from './icons/IconEdit_20.astro';
import IconEditSmall from './icons/IconEdit_14.astro';
import IconEditStop from './icons/IconEditStop_20.astro';
import IconAssessor from './icons/IconAssessor_20.astro';
import IconCopy from './icons/IconCopy_20.astro';
import IconBlank from './icons/IconBlank_20.astro';
import IconTest from './icons/IconTest_20.astro';
import IconAssessment from './icons/IconAssessment_20.astro';
import IconDownload from 'src/components/icons/IconDownload_20.astro';
import IconCog from 'src/components/icons/IconCog_20.astro';
import IconChart from 'src/components/icons/IconChart_20.astro';
import IconMore from 'src/components/icons/IconMore_20.astro';
import IconXmark from './icons/IconXmark_20.astro';
import IconWarningSmall from 'src/components/icons/IconWarning_16.astro';
import IconCheckmark from 'src/components/icons/IconCheckmark_12.astro';
import Toast from './Toast.astro';
import IconWarning16 from 'src/components/icons/IconWarning_16.astro';
---

<section
	id="assessment-controls"
	aria-label="Assessment Controls Toolbar"
	role="toolbar"
>
	<div
		class="notice"
		data-theme="yellow"
		data-vibrancy="vivid"
		data-restrict-device-max="small"
	>
		<div class="wrapper">
			<IconWarning16 />
			<div>
				<p>
					The assessment feature isn't available on small screens. Please use a tablet or
					desktop device to access it.
				</p>
			</div>
		</div>
	</div>

	<div
		class="tools"
		data-restrict-device-min="medium"
	>
		<div class="wrapper">
			<div
				class="info-group button-group"
				data-restrict-mode="assessment"
			>
				<!-- Assessment Title -->
				<div class="field-container icon-and-label-container">
					<IconAssessment />
					<span
						class="label-container"
						data-restrict-length
					>
						<span
							class="label"
							data-field="activeAssessmentName"
						></span>
					</span>
				</div>
				<!-- Edit Status -->
				<button
					type="button"
					class="open-dialog field-container icon-and-label-container"
					data-dialog="edit-status-dialog"
					data-dialog-context="configure"
					aria-label="Change Assessment Status"
					data-style="solid-outline"
					data-vibrancy="vivid"
					data-collapsible="icon"
				>
					<span class="label-container">
						<span
							class="label"
							data-field="status"
						></span>
					</span>
					<span class="icon-container">
						<IconEditSmall />
					</span>
					<span class="tooltip">Change Status</span>
				</button>
				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
					data-restrict-context="big-seven"
					data-restrict-breakpoint-big-seven-min="2"
				>
				</div>
				<!-- Assessment Properties Button -->
				<button
					class="open-dialog"
					data-dialog="view-assessment-properties-dialog"
					type="button"
					aria-label="View Assessment Properties"
					data-restrict-context="big-seven"
					data-restrict-breakpoint-big-seven-min="2"
				>
					<span class="icon-and-label-container">
						<IconInfo />
						<span class="label-container">
							<span class="label">Properties</span>
						</span>
					</span>
					<span class="tooltip">View Properties</span>
				</button>
			</div>
			<div
				class="separator group"
				data-orientation="vertical"
				aria-hidden="true"
				data-restrict-mode="assessment"
			>
			</div>
			<div class="file-group button-group">
				<!-- Open/Import Assessment Button -->
				<button
					class="open-dialog"
					data-dialog="manage-assessments-dialog"
					data-dialog-context="assessment"
					aria-label="Open or Import Assessment"
					type="button"
				>
					<span class="icon-and-label-container">
						<IconFolder />
						<span class="label-container">
							<span class="label">Assessments</span>
						</span>
					</span>
					<span class="tooltip">Manage Assessments</span>
				</button>
				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
					data-restrict-context="big-seven"
				>
				</div>
				<!-- Create Assessment Button -->
				<div
					class="button-container"
					data-restrict-context="big-seven"
				>
					<button
						class="subgroup-toggle"
						aria-label="Create New Assessment"
						type="button"
					>
						<span class="icon-and-label-container">
							<IconCross />
							<span class="label-container">
								<span class="label">New</span>
							</span>
						</span>
						<span class="tooltip">Create Assessment</span>
					</button>

					<ul class="subgroup">
						<li>
							<button
								class="open-dialog"
								data-dialog="edit-assessment-properties-dialog"
								data-dialog-context="setup"
								type="button"
							>
								<span class="icon-and-label-container">
									<IconBlank />
									<span class="label-container">
										<span class="label">Blank Assessment</span>
									</span>
								</span>
							</button>
						</li>
						<li data-restrict-mode="assessment">
							<button
								class="open-dialog"
								data-dialog="edit-assessment-properties-dialog"
								data-dialog-context="duplicate"
								data-dialog-heading="Duplicate Assessment"
								data-dialog-target-id=""
								type="button"
							>
								<span class="icon-and-label-container">
									<IconCopy />
									<span class="label-container">
										<span class="label">Duplicate Assessment</span>
									</span>
								</span>
							</button>
						</li>
						<li>
							<button
								class="open-dialog"
								data-dialog="edit-assessment-properties-dialog"
								data-dialog-context="test"
								data-dialog-heading="Create Test Assessment"
								type="button"
							>
								<span class="icon-and-label-container">
									<IconTest />
									<span class="label-container">
										<span class="label">Test Assessment</span>
									</span>
								</span>
							</button>
						</li>
					</ul>
				</div>
			</div>
			<div
				class="separator group"
				data-orientation="vertical"
				aria-hidden="true"
				data-restrict-mode="assessment"
			>
			</div>
			<div
				class="export-group button-group"
				data-restrict-mode="assessment"
				data-restrict-context="big-seven"
			>
				<!-- Export Assessment Button -->
				<button
					class="open-dialog"
					data-dialog="export-assessment-dialog"
					type="button"
					aria-label="Export Assessment"
					data-restrict-breakpoint-big-seven-min="3"
				>
					<span class="icon-and-label-container">
						<IconSave />
						<span class="label-container">
							<span class="label">Export</span>
						</span>
					</span>
					<span class="tooltip">Export Assessment</span>
				</button>
				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
					data-restrict-breakpoint-big-seven-min="3"
				>
				</div>
				<!-- Export Status -->
				<div class="field-container label-container">
					<span
						class="label"
						data-field="exportStatus"
					></span>
				</div>
			</div>

			<div
				class="separator group"
				data-orientation="vertical"
				data-restrict-mode="assessment"
				aria-hidden="true"
				data-restrict-context="big-seven"
				data-restrict-status="complete"
				data-restrict-breakpoint-big-seven-min="2"
			>
			</div>

			<div
				class="report-group button-group"
				data-restrict-mode="assessment"
				data-restrict-status="complete"
			>
				<!-- View Report Link -->
				<a
					class="open-dialog"
					data-style-as="button"
					href="./report/"
					aria-label="View Report"
					data-restrict-context="big-seven"
					data-restrict-status="complete"
					data-restrict-breakpoint-big-seven-min="2"
				>
					<span class="icon-and-label-container">
						<IconChart />
						<span class="label-container">
							<span class="label">Report</span>
						</span>
					</span>
					<span class="tooltip">View Report</span>
				</a>

				<!-- Report Settings Button -->
				<button
					class="open-dialog"
					data-dialog="report-settings-dialog"
					aria-label="Modify Report Settings"
					type="button"
					data-restrict-context="report"
					data-restrict-breakpoint-report-min="1"
				>
					<span class="icon-and-label-container">
						<IconCog />
						<span class="label-container">
							<span class="label">Report Settings</span>
						</span>
					</span>
					<span class="tooltip">Report Settings</span>
				</button>

				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
					data-restrict-context="report"
					data-restrict-breakpoint-report-min="1"
				>
				</div>

				<!-- Download Report Button -->
				<button
					class="open-dialog"
					data-dialog="report-download-dialog"
					aria-label="Download Report"
					type="button"
					data-restrict-context="report"
				>
					<span class="icon-and-label-container">
						<IconDownload />
						<span class="label-container">
							<span class="label">Download</span>
						</span>
					</span>
					<span class="tooltip">Download Report</span>
				</button>
			</div>

			<div
				class="separator group"
				data-orientation="vertical"
				data-restrict-mode="assessment"
				aria-hidden="true"
				data-restrict-breakpoint-big-seven-min="4"
			>
			</div>

			<!-- User Group -->
			<div
				class="user-group button-group"
				data-restrict-mode="assessment"
				data-restrict-breakpoint-big-seven-min="4"
			>
				<!-- Manage Assessors Button -->
				<button
					class="open-dialog"
					data-dialog="assessor-dialog"
					data-dialog-heading="Manage Assessors"
					data-dialog-context="configure"
					type="button"
					aria-label="Manage Assessors"
					data-restrict-breakpoint-big-seven-min="3"
					data-restrict-breakpoint-report-min="1"
				>
					<span class="icon-and-label-container">
						<IconAssessor />
						<span class="label-container">
							<span class="label">Assessors</span>
						</span>
					</span>
					<span class="tooltip">Manage Assessors</span>
				</button>

				<div
					class="separator item"
					data-orientation="vertical"
					aria-hidden="true"
					data-restrict-assessor="true"
					data-restrict-breakpoint-big-seven-min="3"
					data-restrict-breakpoint-report-min="1"
				>
				</div>

				<!-- Active Assessor -->
				<button
					type="button"
					class="open-dialog field-container icon-and-label-container"
					data-dialog="assessor-dialog"
					data-dialog-heading="Select Active Assessor"
					aria-label="Change Active Assessor"
					data-style="solid-outline"
					data-vibrancy="vivid"
					data-collapsible="icon"
					data-theme="purple"
					data-restrict-assessor="true"
					data-restrict-breakpoint-big-seven-min="4"
				>
					<span
						class="label-container"
						data-restrict-length="short"
					>
						<span
							class="label"
							data-field="activeAssessor"
						></span>
					</span>
					<span class="icon-container">
						<IconEditSmall />
					</span>
					<span class="tooltip">Change Active Assessor</span>
				</button>
			</div>

			<div
				class="separator group"
				data-orientation="vertical"
				data-restrict-mode="assessment"
				data-restrict-breakpoint-big-seven-min="2"
				data-restrict-breakpoint-report-min="1"
				aria-hidden="true"
			>
			</div>

			<!-- Mode Group -->
			<div
				class="mode-group button-group"
				data-restrict-mode="assessment"
				data-restrict-breakpoint-big-seven-min="2"
				data-restrict-breakpoint-report-min="1"
			>
				<!-- Start Editing Button -->
				<button
					class="open-dialog"
					data-dialog="status-warning-dialog"
					aria-label="Edit Completed Assessment"
					type="button"
					data-restrict-status="complete"
					data-restrict-context="big-seven"
				>
					<span class="icon-and-label-container">
						<IconEdit />
						<span class="label-container">
							<span class="label">Edit</span>
						</span>
					</span>
					<span class="tooltip">Edit Assessment</span>
				</button>
				<div
					class="separator item"
					data-orientation="vertical"
					data-restrict-status="complete"
					data-restrict-context="big-seven"
					aria-hidden="true"
				>
				</div>
				<!-- Close Button -->
				<button
					class="close"
					type="button"
					aria-label="Close Assessment"
					data-toast-success="assessment-toolbar_close-toast_success"
					data-toast-failure="assessment-toolbar_close-toast_failure"
				>
					<span class="icon-and-label-container">
						<IconXmark />
						<span class="label-container">
							<span class="label">Close</span>
						</span>
					</span>
					<span class="tooltip">Close Assessment</span>
				</button>
			</div>
			<div
				class="separator group"
				data-orientation="vertical"
				aria-hidden="true"
				data-restrict-mode="assessment"
				data-restrict-breakpoint-big-seven-max="2"
				data-restrict-breakpoint-report-max="1"
			>
			</div>
			<div
				class="more-group button-group"
				data-restrict-breakpoint-big-seven-max="2"
				data-restrict-breakpoint-report-max="1"
			>
				<!-- More Options Buttons -->
				<div class="more button-container">
					<button
						class="subgroup-toggle"
						aria-label="More Options"
						type="button"
					>
						<span class="icon-and-label-container">
							<IconMore />
							<span class="label-container">
								<span class="label">More Options</span>
							</span>
						</span>
						<span class="tooltip">More Options</span>
					</button>

					<ul
						class="subgroup"
						data-align="right"
					>
						<!-- View Properties -->
						<li data-restrict-context="big-seven">
							<button
								class="open-dialog"
								data-dialog="view-assessment-properties-dialog"
								type="button"
								aria-label="View Assessment Properties"
							>
								<span class="icon-and-label-container">
									<IconInfo />
									<span class="label-container">
										<span class="label">View Properties</span>
									</span>
								</span>
							</button>
						</li>

						<!-- Export Assessment Button -->
						<li
							data-restrict-context="big-seven"
							data-restrict-breakpoint-big-seven-max="3"
						>
							<button
								class="open-dialog"
								data-dialog="export-assessment-dialog"
								type="button"
								aria-label="Export Assessment"
							>
								<span class="icon-and-label-container">
									<IconSave />
									<span class="label-container">
										<span class="label">Export Assessment</span>
									</span>
								</span>
							</button>
						</li>

						<!-- View Report -->
						<li
							data-restrict-mode="assessment"
							data-restrict-context="big-seven"
							data-restrict-status="complete"
						>
							<a
								class="open-dialog"
								data-style-as="button"
								href="./report/"
								aria-label="View Report"
							>
								<span class="icon-and-label-container">
									<IconChart />
									<span class="label-container">
										<span class="label">View Report</span>
									</span>
								</span>
							</a>
						</li>

						<li
							data-restrict-context="report"
							data-restrict-breakpoint-report-max="1"
						>
							<button
								class="open-dialog"
								data-dialog="report-settings-dialog"
								aria-label="Modify Report Settings"
								type="button"
							>
								<span class="icon-and-label-container">
									<IconCog />
									<span class="label-container">
										<span class="label">Report Settings</span>
									</span>
								</span>
							</button>
						</li>

						<!-- Manage Assessors -->
						<li data-restrict-breakpoint-big-seven-max="3">
							<button
								class="open-dialog"
								data-dialog="assessor-dialog"
								data-dialog-heading="Manage Assessors"
								data-dialog-context="configure"
								type="button"
								aria-label="Manage Assessors"
							>
								<span class="icon-and-label-container">
									<IconAssessor />
									<span class="label-container">
										<span class="label">Manage Assessors</span>
									</span>
								</span>
							</button>
						</li>

						<!-- Edit Assessment -->
						<li
							data-restrict-status="complete"
							data-restrict-context="big-seven"
						>
							<button
								class="open-dialog"
								data-dialog="status-warning-dialog"
								aria-label="Edit Completed Assessment"
								type="button"
							>
								<span class="icon-and-label-container">
									<IconEdit />
									<span class="label-container">
										<span class="label">Edit Assessment</span>
									</span>
								</span>
							</button>
						</li>
						<!-- Close Assessment -->
						<li>
							<button
								class="close"
								type="button"
								aria-label="Close Assessment"
								data-toast-success="assessment-toolbar_close-toast_success"
								data-toast-failure="assessment-toolbar_close-toast_failure"
							>
								<span class="icon-and-label-container">
									<IconXmark />
									<span class="label-container">
										<span class="label">Close Assessment</span>
									</span>
								</span>
							</button>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>

<style is:global>
	#assessment-controls {
		container-name: assessment-controls;
		container-type: inline-size;

		min-height: 3.75rem;
		top: 0;
		z-index: 11;
		user-select: none;
		-webkit-user-select: none;

		[data-mode='assessment'] & {
			position: sticky;

			@container main (width < 720px) {
				position: static;
			}

			&
				:is(button, [data-style-as='button']):not(
					.field-container,
					.subgroup :is(button, [data-style-as='button'])
				)
				.label-container {
				@container assessment-controls (width < 1840px) {
					display: none;
				}
			}
		}

		& :is(.notice, .tools) > .wrapper {
			max-width: 1920px;
		}

		& > .notice {
			height: 100%;
			background-color: var(--colour-bkg-surface-subtle-1-accent);
			border-bottom: 1px solid var(--colour-brd-subtle-accent);

			:root[data-theme='dark'] & {
				--icon-colour: var(--colour-brd-bold-accent);

				/* background-color: var(--colour-bkg-surface-bold-1-accent); */
				background-color: var(--colour-bkg-surface-subtle-1);
				border-top: 1px solid var(--colour-bkg-surface-bold-1-accent);
				border-bottom: 1px solid var(--colour-bkg-surface-bold-1-accent);
			}

			& > .wrapper {
				--icon-size: 1rem;
				display: flex;
				align-items: center;
				gap: var(--space-base);
				height: 100%;
				padding: var(--space-base) var(--space-2xl);
				margin: 0 auto;

				@container main (width < 720px) {
					padding: var(--space-base) var(--space-xl);
				}
			}

			& p {
				font-size: var(--font-size-2xs);
				line-height: 1.2;
				margin: 0 0 0.125rem;
				text-wrap: balance;
			}
		}

		& > .tools {
			height: 100%;
			background-color: var(--colour-bkg-surface-subtle-1);
			border-top: 1px solid var(--colour-brd-subtle);
			border-bottom: 1px solid var(--colour-brd-subtle);

			& > .wrapper {
				display: flex;
				flex-flow: row nowrap;
				align-items: center;
				gap: var(--space-xs);
				height: 100%;
				padding: 0 var(--space-2xl);
				margin: 0 auto;
			}
		}

		& .button-group {
			--group-gap: var(--space-xs);
			flex-shrink: 0;

			&:has([data-field='exportStatus']) {
				flex-shrink: 1;
			}

			& .button-container {
				position: relative;

				& .subgroup {
					display: none;
					flex-flow: column nowrap;
					align-items: start;
					gap: var(--space-3xs);
					list-style-type: none;
					background-color: var(--colour-bkg-surface-subtle-1);
					border: 1px solid var(--colour-brd-subtle);
					border-radius: var(--brd-radius-normal);
					width: max-content;
					padding: var(--space-2xs);
					box-shadow: var(--box-shadow);
					position: absolute;
					top: calc(2rem + var(--space-xs));
					left: calc(-1 * var(--space-xs));
					z-index: 100;

					&[data-align='right'] {
						right: calc(-1 * var(--space-xs));
						left: unset;
					}

					& li {
						width: 100%;
					}

					& :is(button, [data-style-as='button']) {
						justify-content: start;
						width: 100%;
						font-size: var(--font-size-2xs);
					}
				}

				& .subgroup-toggle[aria-expanded='true'] + .subgroup {
					display: flex;
				}
			}
		}

		main.big-seven & .export-group {
			flex-grow: 1;
		}

		main.report & .report-group {
			flex-grow: 1;
		}

		& :is(button, [data-style-as='button']) {
			position: relative;

			&:not([data-style='solid-outline']) {
				--icon-size: 1.25rem;
				--button-bkg-colour: transparent;

				&:is(:hover, :focus-visible, [aria-expanded='true']) {
					--icon-colour: var(--colour-txt-on-bold-1);
					--label-colour: var(--colour-txt-on-bold-1);
					--button-bkg-colour: var(--colour-bkg-surface-bold-1);
				}
			}

			&:not([aria-expanded='true']):is(:hover, :focus-visible) {
				& .tooltip {
					opacity: 1;
					visibility: visible;
					transition: opacity var(--transition-linear-fast) 750ms;
				}
			}

			&:focus-visible {
				& .tooltip {
					top: calc(100% + var(--space-xs));
				}
			}

			.tooltip {
				position: absolute;
				top: calc(100% + var(--space-2xs));
				left: 50%;
				translate: -50%;
				font-size: var(--font-size-2xs);
				color: var(--colour-txt-on-bold-1);
				line-height: 1.2;
				background-color: var(--colour-bkg-surface-bold-1);
				width: max-content;
				padding: var(--space-2xs) var(--space-2xs);
				border-radius: var(--brd-radius-small);
				visibility: hidden;
				opacity: 0;
				transition: opacity var(--transition-linear-fast) 0s;
			}

			&:is(.close, .more) {
				& .tooltip {
					left: auto;
					right: calc(-1 * var(--space-xs));
					translate: 0;
				}
			}
		}

		& .field-container {
			--icon-size: 1.25rem;
			--label-size: var(--font-size-2xs);
			user-select: none;
			-webkit-user-select: none;

			&:has([data-field='activeAssessmentName']) {
				--label-size: var(--font-size-2xs);
				--label-weight: 700;
				gap: var(--space-xs);
			}

			&:has([data-field='status'], [data-field='activeAssessor']) {
				--container-padding: var(--space-2xs);
				--icon-size: 0.875rem;
				min-height: 1.75rem;
				margin: 0 var(--space-2xs) !important;
			}

			&:has([data-field='exportStatus']) {
				--label-colour: var(--colour-txt-on-subtle-2);
				margin: 0 var(--space-2xs) !important;
				text-wrap: balance;

				& button {
					--link-colour: var(--colour-txt-on-subtle-2);
				}
			}
		}

		& .separator {
			&.group {
				--separator-long-edge-dimension: 100%;
			}

			&.item {
				--separator-long-edge-dimension: 1.75rem;
			}

			main:not([data-assessor='true'])
				&:has(+ .user-group .field-container [data-field='activeAssessor']) {
				@container main (width < 1200px ) {
					display: none !important;
				}
			}
		}

		main:not(.big-seven) & [data-restrict-context='big-seven'] {
			display: none;
		}

		main:not(.report) & [data-restrict-context='report'] {
			display: none;
		}

		& [data-restrict-device-min='medium'] {
			@container main (width < 720px) {
				display: none !important;
			}
		}

		& [data-restrict-device-max='small'] {
			@container main (width >= 720px) {
				display: none !important;
			}
		}

		/* 
		// Big Seven Breakpoints
		*/

		/* First breakpoint, drop the labels */
		main.big-seven & [data-restrict-breakpoint-big-seven-max='1'] {
			@container main (width >= 1600px) {
				display: none !important;
			}
		}
		main.big-seven & [data-restrict-breakpoint-big-seven-min='1'] {
			@container main (width < 1600px) {
				display: none !important;
			}
		}

		/* Second breakpoint, reveal more with first batch (props, report, edit, close) */
		main.big-seven & [data-restrict-breakpoint-big-seven-max='2'] {
			@container main (width >= 1400px) {
				display: none !important;
			}
		}

		main.big-seven & [data-restrict-breakpoint-big-seven-min='2'] {
			@container main (width < 1400px) {
				display: none !important;
			}
		}

		/* Third breakpoint, second batch in more (export btn (not info), manage assessor), add 'Assessor' to Active:Chad */
		main.big-seven & [data-restrict-breakpoint-big-seven-max='3'] {
			@container main (width >= 1200px ) {
				display: none !important;
			}
		}

		main.big-seven & [data-restrict-breakpoint-big-seven-min='3'] {
			@container main (width < 1200px ) {
				display: none !important;
			}
		}

		/* Fourth breakpoint, third batch in more (manage ass. and new ass.) */
		main.big-seven & [data-restrict-breakpoint-big-seven-max='4'] {
			@container main (width >= 1040px ) {
				display: none !important;
			}
		}

		main.big-seven & [data-restrict-breakpoint-big-seven-min='4'] {
			@container main (width < 1040px ) {
				display: none !important;
			}
		}

		/* 
		// Report Breakpoints
		*/

		/* First breakpoint, drop the labels */
		main.report & [data-restrict-breakpoint-report-max='1'] {
			@container main (width >= 900px) {
				display: none !important;
			}
		}
		main.report & [data-restrict-breakpoint-report-min='1'] {
			@container main (width < 900px) {
				display: none !important;
			}
		}
	}
</style>

<script>
	//
	// Imports
	//

	import {
		getActiveAssessmentData,
		getAssessmentName,
		getExportStatus,
		getStatusColour,
		getUserData,
		setAssessment,
		setState,
		setPreferences,
		subscribe,
	} from 'src/stores/userDataStore';
	import { dialogControl } from 'src/utilities/dialog';
	import { eventControl } from 'src/utilities/event';
	import { resetForm } from 'src/utilities/form';
	import { toastControl } from 'src/utilities/toast';

	//
	// DOM Updates
	//

	let updateToolbar = (data: UserData, changes) => {
		let toolbar = document.querySelector('#assessment-controls') as HTMLElement;
		if (!toolbar) return;

		let stateTriggerKeys = ['activeAssessmentId'];
		let assessmentTriggerKeys = [
			'status',
			'reportingYear',
			'school',
			'unexportedChanges',
			'activeAssessor',
		];
		if (
			!changes.initiating &&
			!(
				(changes.assessments &&
					assessmentTriggerKeys.some((val) => changes.assessments.includes(val))) ||
				(changes.uiState && stateTriggerKeys.some((val) => changes.uiState.includes(val)))
			)
		)
			return;

		let assessment = getActiveAssessmentData();
		if (!assessment) return;

		// console.log("Updating Assessment Toolbar");

		// Get the update fields
		let statusField = toolbar?.querySelector('[data-field="status"]');
		let assessmentField = toolbar?.querySelector('[data-field="activeAssessmentName"]');
		let exportField = toolbar?.querySelector('[data-field="exportStatus"]');
		let assessorField = toolbar?.querySelector('[data-field="activeAssessor"]');
		let duplicateBtn = toolbar?.querySelector('[data-dialog-context="duplicate"]');

		if (!assessment) return;

		// 1. Update the assessment status
		if (statusField) {
			if (assessment.status === undefined) {
				statusField.setAttribute('hidden', '');
			} else {
				statusField.removeAttribute('hidden');
			}

			// Create the assessment title string and inject it
			let statusStr = `${assessment.status}`;
			statusField.textContent = statusStr;
			statusField.setAttribute('title', statusStr);
			statusField.closest('.field-container')?.setAttribute('data-theme', getStatusColour());
		}

		// 2. Update the assessment name
		if (assessmentField) {
			if (assessment.reportingYear === undefined || assessment.school === undefined) {
				assessmentField.setAttribute('hidden', '');
			} else {
				assessmentField.removeAttribute('hidden');
			}

			// Create the assessment title string and inject it
			let assessmentStr = getAssessmentName();
			assessmentField.textContent = assessmentStr;
			assessmentField.setAttribute('title', assessmentStr);
		}

		// 3. Update the export status
		if (exportField) {
			if (assessment.unexportedChanges === undefined) {
				exportField.setAttribute('hidden', '');
			} else {
				exportField.removeAttribute('hidden');
			}

			exportField.innerHTML = getExportStatus({}) as string;
		}

		// 4. Update the assessor name
		if (assessorField) {
			if (assessment.activeAssessor === undefined) {
				assessorField.setAttribute('hidden', '');
			} else {
				assessorField.removeAttribute('hidden');
				let assessorStr = `Active: ${assessment.activeAssessor}`;
				assessorField.textContent = assessorStr;
				assessorField.setAttribute('title', assessorStr);
			}
		}

		// 5. Update the duplicate btn target id
		if (duplicateBtn) {
			duplicateBtn.setAttribute('data-dialog-target-id', assessment.id);
		}
	};

	let updateToolbarExportStatus = () => {
		let toolbar = document.querySelector('#assessment-controls') as HTMLElement;
		if (!toolbar) return;

		let userData = getUserData();
		if (userData.uiState.mode !== 'assessment') return;

		// Get the update fields
		let exportField = toolbar?.querySelector('[data-field="exportStatus"]');

		exportField.innerHTML = getExportStatus({}) as string;
	};

	//
	// Inits
	//

	subscribe(updateToolbar);

	// Reset save status every minute
	setInterval(() => {
		updateToolbarExportStatus();
	}, 60_000);

	//
	// Event Listeners
	//

	let onClick = (event) => {
		let target = event.target as HTMLButtonElement;

		let toolbar = document.querySelector('#assessment-controls') as HTMLElement;
		if (!toolbar) return;

		if (target.matches('button.close')) {
			let activeAssessment = getActiveAssessmentData();

			if (activeAssessment.status === 'In Progress') {
				dialogControl.open({
					dialogId: 'edit-status-dialog',
					context: 'close',
					headingText: 'Update Status Before Closing',
				});
			} else {
				if (activeAssessment.unexportedChanges) {
					dialogControl.open({
						dialogId: 'export-warning-dialog',
					});
				} else {
					try {
						setAssessment({
							activeAssessor: null,
						});

						setState({
							mode: 'reading',
							activeAssessmentId: null,
						});

						setPreferences({
							reportIncludedIndicators: ['1', '2', '3', '4', '5', '6', '7'],
						});

						// Reset consideration checkboxes
						for (let input of document.querySelectorAll(
							'input[name="considerationsEstablished"]',
						) as NodeListOf<HTMLInputElement>) {
							input.checked = false;
						}

						// Reset create assessment dialog
						let createDialog = document.querySelector(
							'#edit-assessment-properties-dialog',
						);
						if (createDialog) {
							resetForm({
								form: createDialog.querySelector('form'),
								resetType: 'hard',
							});
						}

						toastControl.show({ target, type: 'success' });
					} catch (error) {
						console.error(error);
						toastControl.show({ target, type: 'failure' });
					}
				}
			}
		}

		if (target.matches('button.subgroup-toggle')) {
			let expanded = target.getAttribute('aria-expanded') === 'true';
			target.setAttribute('aria-expanded', String(!expanded));
		}
	};
	eventControl.add({
		selector: '#assessment-controls',
		eventType: 'click',
		fn: onClick,
	});

	let onDocumentClick = (event) => {
		let target = event.target as any;

		let buttonContainer = document.querySelector(
			'#assessment-controls .button-container:has(.subgroup)',
		);
		if (buttonContainer && !buttonContainer.contains(target)) {
			let btn = buttonContainer.querySelector('.subgroup-toggle');
			btn.setAttribute('aria-expanded', 'false');
		}
	};
	eventControl.add({
		elem: document,
		eventType: 'click',
		fn: onDocumentClick,
	});

	let onFocusout = (event) => {
		let target = event.target as any;
		let next = event.relatedTarget as any;

		if (
			target.matches(
				'button.subgroup-toggle, .subgroup :is(button, [data-style-as="button"])',
			)
		) {
			let buttonContainer = target.closest('.button-container');
			if (buttonContainer && buttonContainer.contains(next)) return;
			let btn = buttonContainer.querySelector('button.subgroup-toggle');
			btn.setAttribute('aria-expanded', 'false');
		}
	};
	eventControl.add({
		selector: '#assessment-controls',
		eventType: 'focusout',
		fn: onFocusout,
	});

	let onFocus = (event) => {};
	eventControl.add({
		selector: '#assessment-controls',
		eventType: 'focus',
		fn: onFocus,
	});

	let onBlur = (event) => {};
	eventControl.add({
		selector: '#assessment-controls',
		eventType: 'blur',
		fn: onBlur,
	});
</script>
