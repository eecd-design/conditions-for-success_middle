---
import IconCaretSmall from './icons/IconCaretDown_14.astro';
import IconCaretMedium from './icons/IconCaretDown_16.astro';
import IconCaretLarge from './icons/IconCaretDown_20.astro';

import { toKebabCase } from '../utilities/helpers';

const { title, id, dataset, crossIconSize = 'large', wrapper = true } = Astro.props;

let datasetAttrs = {};
if (dataset) {
	for (let data of dataset) {
		datasetAttrs[`data-${data.key}`] = data.value;
	}
}

const crossIcons = {
	small: IconCaretSmall,
	medium: IconCaretMedium,
	large: IconCaretLarge,
};

let IconCross = crossIcons[crossIconSize];
---

<div
	class="accordion"
	{...datasetAttrs}
>
	<h3
		id={id ? id : toKebabCase(title)}
		class="heading"
	>
		<button type="button">
			<span class="icon-and-label-container">
				<slot name="button-icon" />
				<span class="label-container">
					<span class="label">{title}</span>
				</span>
			</span>

			<slot name="button-meta" />

			<IconCross />
		</button>
	</h3>

	<div
		class="panel"
		data-js-visibility="hidden"
	>
		{
			wrapper ? (
				<div class="content">
					<slot />
				</div>
			) : (
				<slot />
			)
		}
	</div>
</div>

<style is:global>
	.accordion {
		--label-size: var(--font-size-lg);

		container: accordion / inline-size;

		&[data-font-size='base'] {
			--label-size: var(--font-size-base);
		}

		& > .heading {
			margin: 0;

			& button {
				--default-button-bkg: var(
					--colour-bkg-surface-subtle-1-accent,
					var(--colour-bkg-surface-subtle-1)
				);
				--default-button-bkg-expanded: var(
					--colour-bkg-surface-bold-1-accent,
					var(--colour-bkg-surface-bold-2)
				);
				--default-button-boxshadow-hover: var(
					--colour-brd-subtle-accent,
					var(--colour-brd-subtle)
				);

				:root[data-theme='dark'] & {
					--default-button-bkg: var(--colour-bkg-surface-subtle-1);
					--default-button-bkg-expanded: var(--colour-bkg-surface-bold-2);
					--default-button-boxshadow-hover: var(
						--colour-brd-mid-accent,
						var(--colour-brd-subtle)
					);
				}

				--button-bkg-colour: var(--default-button-bkg);
				--button-brd-radius: var(--brd-radius-normal);
				--button-txt-colour: var(--colour-txt-on-subtle-1);
				--icon-colour: var(--colour-txt-on-subtle-1-accent, var(--colour-txt-on-subtle-1));

				display: flex;
				flex-flow: row nowrap;
				align-items: center;
				gap: var(--space-sm);
				height: auto;
				min-height: 3.5rem;
				width: 100%;
				padding: var(--space-2xs) var(--space-base) var(--space-2xs) var(--space-sm);
				box-shadow: inset 0 0 0 var(--button-boxshadow-width, 2px)
					var(--button-boxshadow-colour, transparent);
				transition: background-color var(--transition-linear-fast);

				/* States */

				&:is(:hover, :focus-visible) {
					--button-bkg-colour: transparent;
					--button-txt-colour: var(--button-txt-colour);
				}

				&:not([aria-expanded='true']):is(:hover, :focus-visible) {
					--button-boxshadow-colour: var(--default-button-boxshadow-hover);
				}

				&[aria-expanded='true'] {
					--button-bkg-colour: var(--default-button-bkg-expanded);
					--icon-colour: var(--colour-txt-on-bold-1);
					border-radius: var(--brd-radius-normal) var(--brd-radius-normal) 0 0;
				}

				/* Icon and Label Container */

				& .icon-and-label-container {
					--container-gap: var(--space-xs);
					/* --label-size: var(--font-size-lg); */
					--icon-size: 1.5rem;
					flex: 1;
					text-align: left;
				}

				&[aria-expanded='true'] .icon-and-label-container {
					--label-colour: var(--colour-txt-on-bold-1);
				}

				/* Caret */

				& > .icon.caret {
					--icon-size: 1rem;
					transition: rotate var(--transition-ease-medium);
					transform-origin: center;
				}

				&[aria-expanded='true'] > .icon.caret {
					rotate: x 180deg;
				}

				/* Tag */

				& .tag {
					font-size: var(--font-size-lg);
					font-weight: 500;
					color: var(--colour-txt-on-subtle-2-accent, var(--colour-txt-on-subtle-2));
					line-height: 1.2;
					text-align: center;
					min-width: 1rem;
				}

				&[aria-expanded='true'] .tag {
					color: var(--colour-txt-on-bold-1);
				}
			}
		}

		& > .panel {
			display: block;
			border: 1px solid
				var(--colour-bkg-surface-bold-1-accent, var(--colour-bkg-surface-bold-2));
			border-radius: 0 0 var(--brd-radius-normal) var(--brd-radius-normal);

			:root[data-theme='dark'] & {
				border-color: var(--colour-bkg-surface-bold-2);
			}

			& :where(p, li, a) {
				font-size: var(--font-size-xs);
				line-height: 1.2;
			}

			& > .content {
				padding: var(--space-lg);
				font-size: var(--font-size-base);

				& :where(p, li, a) {
					font-size: inherit;
					line-height: 1.6;
				}
			}
		}

		/* Javascript Enabled Browsing */

		[data-js] & {
			& > .panel {
				display: none;
			}

			&:has(> .heading > button[aria-expanded='true']) > .panel {
				display: block;
			}
		}
	}
</style>
