---
import IconAudio from 'src/components/icons/IconAudio_24.astro';
import IconDocument from 'src/components/icons/IconDocument_24.astro';
import IconImage from 'src/components/icons/IconImage_24.astro';
import IconPresentation from 'src/components/icons/IconPresentation_24.astro';
import IconVideo from 'src/components/icons/IconVideo_24.astro';
import IconWeb from 'src/components/icons/IconWeb_24.astro';
import IconWebinar from 'src/components/icons/IconWebinar_24.astro';
import IconCourse from 'src/components/icons/IconCourse_24.astro';
import IconCommunity from 'src/components/icons/IconCommunity_24.astro';

const resourceIcons = {
	audio: IconAudio,
	document: IconDocument,
	image: IconImage,
	presentation: IconPresentation,
	video: IconVideo,
	website: IconWeb,
	webinar: IconWebinar,
	course: IconCourse,
	community: IconCommunity,
};

const resourceLabels = {
	audio: 'Audio',
	document: 'Document',
	image: 'Image',
	presentation: 'Presentation',
	video: 'Video',
	website: 'Website',
	webinar: 'Webinar',
	course: 'Course',
	community: 'Community',
};

const {
	type,
	collapsible = true,
	containerClasses = [],
	iconClasses = [],
	dataset = [],
} = Astro.props;

let datasetAttrs = {};
if (dataset) {
	for (let data of dataset) {
		datasetAttrs[`data-${data.key}`] = data.value;
	}
}

let Icon = resourceIcons[type];
let label = resourceLabels[type];
---

{
	Icon && label && (
		<div
			class={['icon-and-label-container', ...containerClasses].join(' ')}
			data-collapsible={collapsible ? 'label' : null}
			{...datasetAttrs}
		>
			<Icon classes={iconClasses} />
			<span class="label-container">
				<span class="label">{label}</span>
			</span>
		</div>
	)
}
