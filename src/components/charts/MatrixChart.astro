---
import IconTrowel24 from 'src/components/icons/IconTrowel_24.astro';
import IconSeed24 from 'src/components/icons/IconSeed_24.astro';
import IconSapling24 from 'src/components/icons/IconSapling_24.astro';
import IconWateringCan24 from 'src/components/icons/IconWateringCan_24.astro';

let { entries, fit = 'normal', colour } = Astro.props;
---

<table
	class="chart-container matrix"
	aria-hidden="true"
	data-fit={fit}
	data-theme={colour ?? null}
>
	<colgroup>
		<col style="width: 25%" />
		<col style="width: 18.75%" />
		<col style="width: 18.75%" />
		<col style="width: 18.75%" />
		<col style="width: 18.75%" />
	</colgroup>
	<thead>
		<tr>
			<th></th>
			<th>
				<div>
					<IconTrowel24 />
					<span>Initiating</span>
				</div>
			</th>
			<th>
				<div>
					<IconSeed24 />
					<span>Implementing</span>
				</div>
			</th>
			<th>
				<div>
					<IconSapling24 />
					<span>Developing</span>
				</div>
			</th>
			<th>
				<div>
					<IconWateringCan24 />
					<span>Sustaining</span>
				</div>
			</th>
		</tr>
	</thead>
	<tbody>
		{
			entries.map((entry) => (
				<tr
					data-phase="initiating"
					data-tag={entry.data.tag}
					data-theme={entry.data.colour ?? null}
					data-vibrancy="vivid"
				>
					<th scope="row">
						<span class="tag">{entry.data.tag}</span>
						{entry.data.title}
					</th>
					<td />
					<td />
					<td />
					<td />
				</tr>
			))
		}
	</tbody>
</table>

<table
	class="matrix-simplified"
	data-screen-reader
>
	<thead>
		<tr>
			<th
				scope="col"
				data-field="scope"
				>Indicator / Component</th
			>
			<th scope="col">Phase Achieved</th>
		</tr>
	</thead>
	<tbody>
		{
			entries.map((entry) => {
				return (
					<tr>
						<th scope="row">
							<span class="tag">{entry.data.tag}</span>
							{entry.data.title}
						</th>
						<td data-field="phase">Initiating</td>
					</tr>
				);
			})
		}
	</tbody>
</table>

<style is:global>
	/* 
	// Matrix Chart
	*/

	.chart-container.matrix {
		width: 100%;
		table-layout: fixed;
		border-collapse: collapse;
		margin: var(--space-base) 0 var(--space-2xl);

		/* Cell Defaults */

		& :is(th, td) {
			height: 4.5rem;
			padding: 0 var(--space-sm);
			position: relative;
			text-align: center;
			vertical-align: middle;
			font-size: var(--font-size-xs);
			color: var(--colour-txt-on-subtle-1);
		}

		& th {
			font-weight: 500;

			& .tag {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				height: 1.125rem;
				min-width: 1.125rem;
				padding: 0 var(--space-3xs);
				margin: 0 0.375rem 0 0;
				float: left;
				background-color: var(--colour-bkg-surface-subtle-1-accent);
				border-radius: var(--brd-radius-small);
				font-size: var(--font-size-3xs);
				font-weight: 500;
				line-height: 1;
				color: var(--colour-txt-on-subtle-1-accent);
			}
		}

		/* Table Head */

		& thead th {
			--icon-colour: var(--colour-txt-on-subtle-2-accent, var(--colour-txt-on-subtle-2));
			--icon-size: 1.75rem;
			border-bottom: 1px solid var(--colour-brd-bold);

			&:first-of-type {
				border: none;
			}

			&:last-of-type {
				border-right: none;
			}

			& div {
				display: inline-flex;
				flex-flow: column;
				align-items: center;
				gap: var(--space-2xs);
			}
		}

		/* Table Body */

		& tbody {
			& :is(th, td) {
				height: auto;
			}

			& th {
				border-right: 1px solid var(--colour-brd-bold);
				border-bottom: 1px solid var(--colour-brd-subtle);
				padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;
				text-align: left;
				vertical-align: bottom;
				position: relative;
				line-height: 1.3;

				[data-fit='compact'] & {
					font-size: var(--font-size-2xs);
					padding: var(--space-2xs) var(--space-2xs) var(--space-2xs) 0;
				}
			}

			& td {
				--dot-diameter: 1.5rem;
				--dot-radius: calc(var(--dot-diameter) / 2);
				border-right: 1px dashed var(--colour-brd-subtle);
				border-bottom: 1px solid var(--colour-brd-subtle);
				line-height: 1;

				[data-fit='compact'] & {
					--dot-diameter: 0.75rem;
				}
			}

			& tr td:last-of-type {
				border-right: 1px solid var(--colour-brd-bold);
			}

			& tr:last-of-type td {
				border-bottom: 1px solid var(--colour-brd-bold);
			}

			section.summary & tr:last-of-type th {
				border-bottom: 1px solid var(--colour-brd-bold);
			}

			& tr:has(+ tr[data-tag*='.1']:not([data-tag='1.1'])) :is(th, td) {
				border-bottom: 1px solid var(--colour-brd-bold);
			}
		}

		/* Position Dot */

		& td::after {
			content: '';
			display: none;
			flex-shrink: 0;
			border-radius: 10rem;
			height: var(--dot-diameter);
			width: var(--dot-diameter);
			background-color: var(
				--colour-bkg-surface-bold-1-accent,
				var(--colour-bkg-surface-bold-2)
			);
			position: absolute;
			top: calc(50% - var(--dot-radius));
			left: calc(50% - var(--dot-radius));
			z-index: 2;
		}

		& tr[data-phase='initiating'] td:nth-of-type(1)::after,
		& tr[data-phase='implementing'] td:nth-of-type(2)::after,
		& tr[data-phase='developing'] td:nth-of-type(3)::after,
		& tr[data-phase='sustaining'] td:nth-of-type(4)::after {
			display: inline-block;
		}

		/* Position Line */

		& td::before {
			content: '';
			display: none;
			border-radius: 10rem;
			height: var(--dot-diameter);
			background-color: var(
				--colour-bkg-surface-subtle-1-accent,
				var(--colour-bkg-surface-subtle-1)
			);
			position: absolute;
			top: calc(50% - var(--dot-radius));
			z-index: 1;
		}

		/* Center to Right Margin */
		&
			tr:is([data-phase='implementing'], [data-phase='developing'], [data-phase='sustaining'])
			td:nth-of-type(1)::before {
			display: inline-block;
			left: calc(50% - var(--dot-radius));
			border-radius: 10rem 0 0 10rem;
			width: calc(50% + var(--dot-radius) + 2px);
		}

		/* Left Margin to Right Margin */
		& tr:is([data-phase='developing'], [data-phase='sustaining']) td:nth-of-type(2)::before,
		& tr:is([data-phase='sustaining']) td:nth-of-type(3)::before {
			display: inline-block;
			left: -2px;
			border-radius: 0;
			width: calc(100% + 4px);
		}

		/* Left Margin to Center */
		& tr:is([data-phase='implementing']) td:nth-of-type(2)::before,
		& tr:is([data-phase='developing']) td:nth-of-type(3)::before,
		& tr:is([data-phase='sustaining']) td:nth-of-type(4)::before {
			display: inline-block;
			left: -2px;
			border-radius: 0 10rem 10rem 0;
			width: calc(50% + var(--dot-radius) + 2px);
		}
	}
</style>
