---
import IconTrowel24 from 'src/components/icons/IconTrowel_24.astro';
import IconSeed24 from 'src/components/icons/IconSeed_24.astro';
import IconSapling24 from 'src/components/icons/IconSapling_24.astro';
import IconWateringCan24 from 'src/components/icons/IconWateringCan_24.astro';

let { colour } = Astro.props;
---

<div
	class="chart-container bar"
	aria-hidden="true"
>
	<div
		class="segment-container"
		data-phase="initiating"
		data-theme="blue"
		data-vibrancy="vivid"
	>
		<div class="title-container">
			<span class="title">Initiating</span>
		</div>
		<div class="block-container">
			<IconTrowel24 />
			<div class="gridlines"></div>
			<div class="block"></div>
		</div>
		<div class="value-container">
			<span class="count">
				<span data-field="count">0</span>
				<span> / </span>
				<span
					class="total"
					data-field="total"
					>0</span
				>
			</span>
			<span>Components</span>
		</div>
	</div>
	<div
		class="segment-container"
		data-phase="implementing"
		data-theme="blue"
		data-vibrancy="vivid"
	>
		<div class="title-container">
			<span class="title">Implementing</span>
		</div>
		<div class="block-container">
			<IconSeed24 />
			<div class="gridlines"></div>
			<div class="block"></div>
		</div>
		<div class="value-container">
			<span class="count">
				<span data-field="count">0</span>
				<span> / </span>
				<span
					class="total"
					data-field="total"
				>
					0</span
				>
			</span>
			<span>Components</span>
		</div>
	</div>
	<div
		class="segment-container"
		data-phase="developing"
		data-theme="blue"
		data-vibrancy="vivid"
	>
		<div class="title-container">
			<span class="title">Developing</span>
		</div>
		<div class="block-container">
			<IconSapling24 />
			<div class="gridlines"></div>
			<div class="block"></div>
		</div>
		<div class="value-container">
			<span class="count">
				<span data-field="count">0</span>
				<span> / </span>
				<span
					class="total"
					data-field="total"
					>0</span
				>
			</span>
			<span>Components</span>
		</div>
	</div>
	<div
		class="segment-container"
		data-phase="sustaining"
		data-theme="blue"
		data-vibrancy="vivid"
	>
		<div class="title-container">
			<span class="title">Sustaining</span>
		</div>
		<div class="block-container">
			<IconWateringCan24 />
			<div class="gridlines"></div>
			<div class="block"></div>
		</div>
		<div class="value-container">
			<span class="count">
				<span data-field="count">0</span>
				<span> / </span>
				<span
					class="total"
					data-field="total"
					>0</span
				>
			</span>
			<span>Components</span>
		</div>
	</div>
</div>

<div
	class="bar-simplified"
	data-screen-reader
>
	<p data-phase="initiating">
		<span data-field="count"></span> out of <span data-field="total"></span> components are currently
		initiating.
	</p>
	<p data-phase="implementing">
		<span data-field="count"></span> out of <span data-field="total"></span> components are currently
		implementing.
	</p>
	<p data-phase="developing">
		<span data-field="count"></span> out of <span data-field="total"></span> components are currently
		developing.
	</p>
	<p data-phase="sustaining">
		<span data-field="count"></span> out of <span data-field="total"></span> components are currently
		sustaining.
	</p>
</div>

<style is:global>
	/* 
	// Bar Chart
	*/

	.chart-container.bar {
		--chart-scale: 1;

		display: grid;
		grid-template-columns: 1fr 1fr 1fr 1fr;
		align-items: end;
		margin: var(--space-xl) 0;

		& .segment-container {
			--total: 0;
			--count: 0;
			--bar-max-height: 200px;

			display: flex;
			flex-flow: column nowrap;
			align-items: center;
			gap: calc(var(--space-sm) * var(--chart-scale));
			position: relative;

			/* Block */

			& .block-container {
				--icon-size: calc(2.5rem * var(--chart-scale));
				--icon-colour: var(--colour-txt-on-subtle-2-accent, var(--colour-txt-on-subtle-2));
				--container-gap: calc(var(--space-xs) * var(--chart-scale));

				display: flex;
				flex-flow: column nowrap;
				flex-grow: 1;
				justify-content: end;
				align-items: center;
				gap: var(--container-gap);
				width: 100%;
				max-height: calc(
					(var(--bar-max-height) * var(--chart-scale)) + var(--icon-size) +
						var(--container-gap) + 1px
				);
				min-height: calc(
					(var(--bar-max-height) * var(--chart-scale)) + var(--container-gap) + 1px
				);

				border-bottom: 1px solid var(--colour-brd-bold);
				overflow: hidden;
				position: relative;

				& .gridlines {
					--grid-step: 5;
					--grid-size: calc(100% / (var(--total) / var(--grid-step)));

					height: calc((var(--bar-max-height)) * var(--chart-scale));
					width: 100%;
					position: absolute;
					bottom: 0;
					background-image: linear-gradient(
						to bottom,
						var(--colour-brd-subtle) 1px,
						transparent 1px
					);
					background-size: 100% var(--grid-size);
					background-position: var(--grid-size) left;
					z-index: 0;
				}

				& .icon {
					width: var(--icon-size);
					z-index: 1;
					overflow: visible;

					stroke: var(--colour-bkg-canvas-subtle-1);
					stroke-width: var(--space-2xs);
					stroke-linejoin: round;
					paint-order: stroke fill;
					vector-effect: non-scaling-stroke;
				}

				.block {
					--icon-colour: var(--colour-txt-on-bold-1);

					display: flex;
					align-items: center;
					justify-content: center;
					height: calc(
						((var(--count) / var(--total)) * var(--bar-max-height)) * var(--chart-scale)
					);
					width: min(100%, 140px);
					background-color: var(
						--colour-bkg-surface-bold-1-accent,
						var(--colour-bkg-surface-bold-2)
					);
					border-radius: var(--brd-radius-normal) var(--brd-radius-normal) 0 0;
					overflow: hidden;
					z-index: 2;
				}
			}

			/* Title */

			& .title-container {
				display: flex;
				flex-flow: column nowrap;
				align-items: center;
				justify-content: end;
				gap: calc(var(--space-2xs) * var(--chart-scale));
				flex-grow: 1;

				& .title {
					font-size: calc(var(--font-size-sm) * var(--chart-scale));
					font-weight: 500;
				}
			}

			/* Value */

			& .value-container {
				display: flex;
				flex-flow: column nowrap;
				align-items: center;
				gap: calc(var(--space-3xs) * var(--chart-scale));
				flex-grow: 1;
				padding: 0 var(--space-xs);
				font-size: calc(var(--font-size-xs) * var(--chart-scale));
				text-align: center;
				color: var(--colour-txt-on-subtle-2);

				& .count {
					font-size: calc(var(--font-size-sm) * var(--chart-scale));
					font-weight: 600;
				}
			}
		}

		#print-report-container & {
			--chart-scale: 0.75;
		}
	}
</style>
