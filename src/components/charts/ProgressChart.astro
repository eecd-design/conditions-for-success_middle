---
import IconTrowel24 from 'src/components/icons/IconTrowel_24.astro';
import IconArrowDown16 from 'src/components/icons/IconArrowDown_16.astro';
import IconSeed24 from 'src/components/icons/IconSeed_24.astro';
import IconSapling24 from 'src/components/icons/IconSapling_24.astro';
import IconWateringCan24 from 'src/components/icons/IconWateringCan_24.astro';

let { colour } = Astro.props;
---

<div
	class="chart-container progress"
	aria-hidden="true"
	data-theme={colour ?? null}
	data-vibrancy="vivid"
>
	<div
		class="segment-container"
		data-phase="initiating"
	>
		<div class="title-container">
			<div class="active-container">
				<span>Currently</span>
				<IconArrowDown16 />
			</div>
			<span class="title">Initiating</span>
		</div>
		<div class="block-container">
			<div class="block">
				<IconTrowel24 />
			</div>
		</div>
		<div class="details-container">
			<span class="count">
				<span data-field="count">0</span>&nbsp;/&nbsp;<span data-field="total">0</span>
			</span>
			<span>Considerations Established</span>
		</div>
	</div>
	<div
		class="segment-container"
		data-phase="implementing"
	>
		<div class="title-container">
			<div class="active-container">
				<span>Currently</span>
				<IconArrowDown16 />
			</div>
			<span class="title">Implementing</span>
		</div>
		<div class="block-container">
			<div class="block">
				<IconSeed24 />
			</div>
		</div>
		<div class="details-container">
			<span class="count">
				<span data-field="count">0</span>&nbsp;/&nbsp;<span data-field="total">0</span>
			</span>
			<span>Considerations Established</span>
		</div>
	</div>
	<div
		class="segment-container"
		data-phase="developing"
	>
		<div class="title-container">
			<div class="active-container">
				<span>Currently</span>
				<IconArrowDown16 />
			</div>
			<span class="title">Developing</span>
		</div>
		<div class="block-container">
			<div class="block">
				<IconSapling24 />
			</div>
		</div>
		<div class="details-container">
			<span class="count">
				<span data-field="count">0</span>&nbsp;/&nbsp;<span data-field="total">0</span>
			</span>
			<span>Considerations Established</span>
		</div>
	</div>
	<div
		class="segment-container"
		data-phase="sustaining"
	>
		<div class="title-container">
			<div class="active-container">
				<span>Currently</span>
				<IconArrowDown16 />
			</div>
			<span class="title">Sustaining</span>
		</div>
		<div class="block-container">
			<div class="block">
				<IconWateringCan24 />
			</div>
		</div>
		<div class="details-container">
			<span class="count">
				<span data-field="count">0</span>&nbsp;/&nbsp;<span data-field="total">0</span>
			</span>
			<span>Considerations Established</span>
		</div>
	</div>
</div>

<div
	class="progress-simplified"
	data-screen-reader
>
	<p>Phase Achieved: <strong data-field="phase">Initiating</strong></p>
	<dl>
		<dt>Initiating</dt>
		<dd>
			<span data-field="count"></span> of <span data-field="total"></span>
			considerations established
		</dd>

		<dt>Implementing</dt>
		<dd>
			<span data-field="count"></span> of <span data-field="total"></span>
			considerations established
		</dd>

		<dt>Developing</dt>
		<dd>
			<span data-field="count"></span> of <span data-field="total"></span>
			considerations established
		</dd>

		<dt>Sustaining</dt>
		<dd>
			<span data-field="count"></span> of <span data-field="total"></span>
			considerations established
		</dd>
	</dl>
</div>

<style is:global>
	/* 
	// Progress Chart
	*/

	.chart-container.progress {
		--chart-scale: 1;

		display: grid;
		grid-template-columns: 1fr 1fr 1fr 1fr;
		padding: calc(var(--space-2xl) * var(--chart-scale)) 0;
		margin: 0;

		& .segment-container {
			display: flex;
			flex-flow: column nowrap;
			gap: calc(var(--space-sm) * var(--chart-scale));
			position: relative;

			/* Block */

			& .block-container .block {
				--icon-size: calc(2.5rem * var(--chart-scale));
				--icon-colour: var(--colour-txt-on-subtle-2-accent, var(--colour-txt-on-subtle-2));
				display: flex;
				align-items: center;
				justify-content: center;
				height: calc(100px * var(--chart-scale));
				background-color: var(
					--colour-bkg-surface-subtle-1-accent,
					var(--colour-bkg-surface-subtle-1)
				);
			}

			&:first-of-type .block-container .block {
				border-radius: var(--brd-radius-normal) 0 0 var(--brd-radius-normal);
			}

			&:last-of-type .block-container .block {
				border-radius: 0 var(--brd-radius-normal) var(--brd-radius-normal) 0;
			}

			&[data-active] .block-container .block {
				--icon-colour: var(--colour-txt-on-bold-1);
				height: calc(140px * var(--chart-scale));
				border-radius: var(--brd-radius-normal);
				background-color: var(
					--colour-bkg-surface-bold-1-accent,
					var(--colour-bkg-surface-bold-2)
				);
			}

			&:not([data-active]) + :not([data-active]) .block-container .block {
				border-left: 2px solid var(--colour-brd-subtle-accent, var(--colour-brd-subtle));
			}

			/* Title */

			& .title-container {
				display: flex;
				flex-flow: column nowrap;
				align-items: center;
				justify-content: end;
				gap: calc(var(--space-2xs) * var(--chart-scale));
				flex-grow: 1;
				color: var(--colour-txt-on-subtle-1);

				& .title {
					font-size: calc(var(--font-size-sm) * var(--chart-scale));
					font-weight: 500;
				}

				/* Active Flag */

				& .active-container {
					--icon-size: calc(1rem * var(--chart-scale));
					--icon-colour: var(
						--colour-txt-on-subtle-2-accent,
						var(--colour-txt-on-subtle-2)
					);
					display: flex;
					flex-flow: column nowrap;
					align-items: center;
					gap: calc(var(--space-3xs) * var(--chart-scale));
					position: absolute;
					top: calc(-2.5rem * var(--chart-scale));

					& span {
						font-size: calc(var(--font-size-3xs) * var(--chart-scale));
						font-weight: 700;
						text-transform: uppercase;
						color: var(--colour-txt-on-subtle-2-accent, var(--colour-txt-on-subtle-2));
					}
				}
			}

			&[data-active] .title-container .title {
				font-size: calc(var(--font-size-base) * var(--chart-scale));
				font-weight: 600;
			}

			&:not([data-active]) .title-container .active-container {
				display: none;
			}

			/* Details */

			& .details-container {
				display: flex;
				flex-flow: column nowrap;
				align-items: center;
				gap: calc(var(--space-3xs) * var(--chart-scale));
				flex-grow: 1;
				padding: 0 var(--space-xs);
				font-size: calc(var(--font-size-2xs) * var(--chart-scale));
				color: var(--colour-txt-on-subtle-2);
				text-align: center;

				& .count {
					font-size: calc(var(--font-size-xs) * var(--chart-scale));
					font-weight: 600;
				}
			}
		}

		#print-report-container & {
			--chart-scale: 0.75;
		}
	}
</style>
