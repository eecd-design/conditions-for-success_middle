---
import AccordionGroup from './AccordionGroup.astro';
import Accordion from './Accordion.astro';
import IconArrowDown16 from './icons/IconArrowDown_16.astro';
import IconArrowRight16 from './icons/IconArrowRight_16.astro';

const { navSections, dataset } = Astro.props;

let datasetAttrs = {};
if (dataset) {
	for (let data of dataset) {
		datasetAttrs[`data-${data.key}`] = data.value;
	}
}
---

<nav
	class="right-aside on-page"
	{...datasetAttrs}
	aria-label="Page Section Navigation"
>
	{
		navSections.length === 1 ? (
			<>
				<h2 class="heading">{navSections[0].title}</h2>
				<ul class="links-list">
					{navSections[0].links.map((link) => {
						let linkDatasetAttrs = {};
						if (link.dataset) {
							for (let data of link.dataset) {
								linkDatasetAttrs[`data-${data.key}`] = data.value;
							}
						}
						return (
							<li>
								<a
									href={link.url}
									{...linkDatasetAttrs}
								>
									<span class="icon-and-label-container">
										<span class="label-container">
											<span class="label">
												<Fragment set:html={link.text} />
											</span>
										</span>
										<IconArrowDown16 classes={['destination']} />
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			</>
		) : (
			<>
				<AccordionGroup includeControls={false}>
					{navSections.map((section, index) => {
						let isOnPageSection = section.title.toLowerCase() === 'on this page';

						return (
							<>
								<Accordion
									title={section.title}
									headingLevel="2"
									caretIconSize={'small'}
									wrapper={false}
									dataset={[
										{ key: 'style', value: 'flat' },
										{
											key: 'default-state',
											value: isOnPageSection ? 'open' : 'closed',
										},
									]}
								>
									<div
										class="separator item"
										aria-hidden="true"
									/>
									<ul class="links-list">
										{section.links.map((link) => {
											let linkDatasetAttrs = {};
											if (link.dataset) {
												for (let data of link.dataset) {
													linkDatasetAttrs[`data-${data.key}`] =
														data.value;
												}
											}
											return (
												<li>
													<a
														href={link.url}
														{...linkDatasetAttrs}
													>
														<span class="icon-and-label-container">
															<span class="label-container">
																<span class="label">
																	<Fragment
																		set:html={link.text}
																	/>
																</span>
															</span>
															{section.title.toLowerCase() ===
															'the big seven' ? (
																<IconArrowRight16
																	classes={['destination']}
																/>
															) : (
																<IconArrowDown16
																	classes={['destination']}
																/>
															)}
														</span>
													</a>
												</li>
											);
										})}
									</ul>
								</Accordion>
								{index < navSections.length - 1 && (
									<div
										class="separator group"
										aria-hidden="true"
									/>
								)}
							</>
						);
					})}
				</AccordionGroup>
			</>
		)
	}
</nav>

<style is:global>
	nav.on-page {
		position: sticky;
		top: var(--space-2xl);
		height: fit-content;
		margin: var(--space-2xl) 0 !important;

		main.big-seven[data-mode='assessment'] & {
			top: calc(3.75rem + var(--space-2xl));
		}

		& .heading {
			font-size: var(--font-size-lg);
			border-bottom: 1px solid var(--colour-brd-subtle);
			padding: 0 0 var(--space-sm);
			margin: 0;

			.accordion & {
				border: none;
				padding: 0;
			}
		}

		& .links-list {
			padding-bottom: var(--space-lg);

			& li {
				line-height: 1.2;

				& a {
					--label-size: var(--font-size-xs);
				}
			}
		}

		/* Accordion Customization */
		& .accordion {
			& .panel {
				padding-top: var(--space-2xs);
				margin: 0 var(--space-2xs);
			}
		}

		& .separator.group {
			--separator-long-edge-dimension: auto;
			margin: 0 var(--space-2xs);
		}
	}
</style>
