{
	"extends": "astro/tsconfigs/base",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"@assets/*": ["./src/assets/*"]
		},
		"strictNullChecks": false,
		"noImplicitAny": false
	}
}
